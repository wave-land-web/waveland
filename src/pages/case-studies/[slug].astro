---
import Link from '../../components/ui/Link.tsx'
import ClosingCTA from '../../components/ui/ClosingCTA.astro'
import PortableText from '../../components/portable-text/PortableText.astro'
import CaseStudyHeader from '../../components/case-study/CaseStudyHeader.astro'
import CaseStudyLightbox from '../../components/case-study/CaseStudyLightbox.astro'
import PostTableOfContents from '../../components/case-study/PostTableOfContents.astro'
import Layout from '../../layouts/Layout.astro'
import { sanityClient } from 'sanity:client'
import { CASE_STUDY_PAGES_QUERY } from '../../sanity/lib/queries'
import type { CASE_STUDY_PAGES_QUERY_RESULT } from '../../sanity/sanity.types'
import { urlForImage } from '../../sanity/lib/urlForImage'

// Every case study comes back in one query at build time, and each page gets its own as a prop
export async function getStaticPaths() {
  const caseStudies = await sanityClient.fetch(CASE_STUDY_PAGES_QUERY)
  return caseStudies.map((caseStudy) => ({ params: { slug: caseStudy.slug.current }, props: { caseStudy } }))
}

interface Props {
  caseStudy: CASE_STUDY_PAGES_QUERY_RESULT[number]
}

const { caseStudy: currentCaseStudy } = Astro.props

// Search and link previews: the case study's own SEO fields when set, otherwise its title and card description.
// "Case Study" in the title says what the page is in a list of search results.
const seoTitle = currentCaseStudy.seo?.title || `${currentCaseStudy.title} Case Study | Wave Land`
const seoDescription = currentCaseStudy.seo?.description || currentCaseStudy.description

// Share image for link previews: a 1200×630 crop of the cover, the shape Slack and LinkedIn show
const imageUrl = urlForImage(currentCaseStudy.mainImage).width(1200).height(630).fit('crop').format('jpg').quality(80).url()

const pageUrl = new URL(`/case-studies/${currentCaseStudy.slug.current}/`, Astro.site).href
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: currentCaseStudy.title,
    description: seoDescription,
    image: imageUrl,
    datePublished: currentCaseStudy.publishedAt,
    url: pageUrl,
    author: { '@type': 'Person', name: 'Josh Nussbaum', url: 'https://wavelandweb.com/' },
    publisher: { '@id': 'https://wavelandweb.com/#business' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wavelandweb.com/' },
      { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://wavelandweb.com/case-studies/' },
      { '@type': 'ListItem', position: 3, name: currentCaseStudy.title, item: pageUrl },
    ],
  },
]
---

<Layout title={seoTitle} description={seoDescription} socialImage={imageUrl} ogType="article" schema={schema}>
  <CaseStudyHeader
    title={currentCaseStudy.title}
    published={currentCaseStudy.publishedAt}
    minutesRead={currentCaseStudy.estimatedReadingTime}
    image={currentCaseStudy.mainImage}
    imageAlt={currentCaseStudy.mainImage.alt}
    services={currentCaseStudy.services ?? []}
    liveUrl={currentCaseStudy.liveUrl ?? undefined}
  />

  <main>
    <div class="grid grid-cols-1 gap-split md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] xl:grid-cols-[minmax(0,1fr)_minmax(0,var(--container-prose-column))_minmax(0,1fr)]">
      <PostTableOfContents post={currentCaseStudy} />
      <section id="case-study" class="py-0">
        <div id="case-study-content" class="flex flex-col gap-[1lh]">
          <PortableText portableText={currentCaseStudy.body} />
          <div class="pt-[1lh] border-t border-dashed border-darkGrey">
            <Link text="View Case Studies" url="/case-studies/" />
          </div>
        </div>
      </section>
      <div class="hidden xl:block"></div>
    </div>
    <section id="get-started">
      <ClosingCTA title="Working on Something Like This?" description="Tell me what you're building. I reply within 48 hours." />
    </section>
  </main>
  <CaseStudyLightbox />
</Layout>
