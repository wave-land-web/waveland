---
import Link from '../components/ui/Link.tsx'
import PageHeader from '../components/layout/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page Not Found | Wave Land" noindex>
  <PageHeader title="404" subtitle="Page Not Found" bodyText="This page doesn't exist, or it's moved.">
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-center">
      <Link text="Home" url="/" color="purple" />
      <Link text="Case Studies" url="/case-studies/" color="orange" />
      <Link text="Contact" url="/contact/" color="green" />
    </div>
  </PageHeader>
</Layout>
