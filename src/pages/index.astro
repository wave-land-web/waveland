---
import { CALENDLY_URL } from '../lib/site'
import bgdImage from '../assets/bgd-mobile.webp'
import lsomImage from '../assets/lsom-mobile.webp'
import supervoidImage from '../assets/supervoid.webp'
import ClosingCTA from '../components/ui/ClosingCTA.astro'
import CTA from '@wave-land-web/design/components/CTA.tsx'
import Link from '@wave-land-web/design/components/Link.tsx'
import Pill from '@wave-land-web/design/components/Pill.astro'
import TextAndImage from '../components/ui/TextAndImage.astro'
import TitleLogo from '@wave-land-web/design/components/TitleLogo.astro'
import Process from '../components/ui/Process.astro'
import Marquee from '../components/layout/Marquee.astro'
import Testimonials from '../components/ui/Testimonials.astro'
import Layout from '../layouts/Layout.astro'
import { sanityClient } from 'sanity:client'
import { TESTIMONIALS_QUERY } from '../sanity/lib/queries'

// Homepage FAQ. Also sent to search and AI answer engines as FAQPage structured data.
// Answers can hold [text](url) links: they render as links on the page and as plain text in the structured data.
// Client quotes for the carousel, edited in Studio (Testimonials)
const testimonialData = await sanityClient.fetch(TESTIMONIALS_QUERY)

const faqs = [
  {
    question: 'I built my site with AI. Can you work with it?',
    answer:
      "Yes. I’ll review what you have, keep what works, and fix what doesn’t. Sometimes that’s a few targeted fixes; sometimes a rebuild is cheaper in the long run. After a short call, I’ll tell you which, with a fixed price either way.",
  },
  {
    question: 'Which platforms do you work on?',
    answer:
      'For custom builds, I use [Astro](https://astro.build) and [Sanity](https://www.sanity.io). Both are built to scale. I also work on the platform you know best, like Webflow, WordPress, Shopify, HubSpot, Squarespace, or Wix.',
  },
  {
    question: 'Do you work with agencies?',
    answer:
      'Yes. I partner with agencies as a white-label developer: building from your designs, joining client calls as part of your team, or staying behind the scenes.',
  },
  {
    question: 'What if my site needs to grow?',
    answer:
      "I plan for growth by default. On custom builds, I start with a set of sections designed around your brand, so every new page fits, whether you make it or I do. Bigger additions, like a store, don’t mean starting over.",
  },
  {
    question: "What’s included in every build?",
    answer:
      'Every site loads fast, works with a keyboard and a screen reader, and is set up so search engines and AI answer engines can read it.',
  },
  {
    question: 'What does it cost?',
    answer:
      'Every new build gets a fixed price up front, based on how big it is and what it needs to do. Ongoing support is priced separately (monthly or as needed).',
  },
]

const linkPattern = /\[([^\]]+)\]\(([^)]+)\)/g
const plainText = (answer: string) => answer.replace(linkPattern, '$1')
// split() with the two capture groups returns text, link text, url, text, … in that order
const answerParts = (answer: string) =>
  answer.split(linkPattern).reduce<{ text: string; href?: string }[]>((parts, piece, i, all) => {
    if (i % 3 === 0) parts.push({ text: piece })
    else if (i % 3 === 1) parts.push({ text: piece, href: all[i + 1] })
    return parts
  }, [])

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: plainText(answer) },
  })),
}
---

<Layout title="Wave Land | Websites That Work as Well as They Look" schema={[faqSchema]}>
  {/* A minimum, not a fixed height: on short screens the hero grows and pushes the logos down instead of overlapping them */}
  <header class="min-h-[80svh] md:min-h-[min(calc(100dvh-3rem),1200px)] pt-[var(--nav-height)] flex flex-col justify-between gap-12">
    <div>
      <div class="mb-6 hero-in">
        <TitleLogo />
      </div>

      <div class="flex flex-wrap gap-2 md:gap-4">
        <Pill text="Development" class="border-purple text-purple hero-in" style="--i: 1" />
        <Pill text="Strategy" class="border-orange text-orange hero-in" style="--i: 2" />
        <Pill text="Partnership" class="border-green text-green hero-in" style="--i: 3" />
      </div>
    </div>
    <div class="max-w-3xl">
      <h1 class="h3 max-w-[22ch] mb-4 text-lightGrey hero-in" style="--i: 4">
        Websites that work as well as they look.
      </h1>
      <p class="max-w-[48ch] mb-6 md:mb-8 text-grey text-balance hero-in" style="--i: 5">
        A development partner for growing businesses, and the creative agencies that build for them.
      </p>
      <div class="hero-in" style="--i: 6">
        <CTA tag="link" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" text="Book a 15-Minute Call" size="large" />
      </div>
    </div>
  </header>

  <Marquee />

  <main>
    <section id="introduction">
      <TextAndImage
        title="Supervoid."
        text="A portfolio that feels like the stage shows it sells."
        caseStudyUrl="/case-studies/supervoid/"
        linkText="Supervoid case study"
        image={supervoidImage}
        imageAlt="Supervoid website on a phone"
        color="purple"
        class="py-section"
      />
      <TextAndImage
        title="Big Giant Donut."
        text="A launch site for a new product with 40 years behind it, built to grow."
        caseStudyUrl="/case-studies/big-giant-donut/"
        linkText="Big Giant Donut case study"
        image={bgdImage}
        isReversed={true}
        imageAlt="Big Giant Donut website on a phone"
        color="orange"
        class="py-section"
      />
      <TextAndImage
        title="Lymphatic Specialists of Madison."
        text="An accessible clinic site that supports patients from their first search to their first visit."
        caseStudyUrl="/case-studies/lymphatic-specialists-of-madison/"
        linkText="LSOM case study"
        image={lsomImage}
        imageAlt="Lymphatic Specialists of Madison website on a phone"
        color="green"
        class="py-section"
      />
      <div class="lsa">
        <Link text="View Case Studies" url="/case-studies/" size="display" />
      </div>
    </section>

    <Process />

    {/* Founder (Hi, I'm Josh) is hidden while its copy is reworked; restore it here and its import above */}

    {/* The section keeps the standard section spacing; the tinted panel is its own container inside it */}
    <section id="faq" class="lsa">
      <div class="section-split p-6 md:p-10 lg:p-12 bg-purple/5 rounded-media shadow-md">
        <h2>
          <span class="text-green">Common</span> Questions
        </h2>

        <div>
          {
            // One open at a time (name groups them); the first starts open
            faqs.map((faq, i) => (
              <details name="faq" open={i === 0} class="mb-4 group">
                <summary class="flex justify-between gap-4 group-open:text-purple group-open:font-semibold group-hover:text-purple transition duration-(--transition) cursor-pointer">
                  {faq.question}
                </summary>
                <p class="py-4 text-lightGrey text-prose">
                  {answerParts(faq.answer).map(({ text, href }) =>
                    href ? (
                      // On one line: whitespace around the text would be underlined as part of the link
                      // prettier-ignore
                      <a href={href} target="_blank" rel="noopener noreferrer" class="text-purple underline decoration-1 underline-offset-4 hover:text-grey transition-colors duration-(--transition)">{text}</a>
                    ) : (
                      text
                    ),
                  )}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* A bordered, left-aligned quote card, so it reads differently from the open, centered sign-off below */}
    <section id="testimonials" class="section-split lsa">
      <h2>What Clients Say</h2>
      <div class="min-w-0">
        <Testimonials data={testimonialData} />
      </div>
    </section>

    <section id="get-started">
      <ClosingCTA
        title="Wherever You’re Starting From"
        description="Whether it’s a new build or one that’s halfway there, I’ll close the gap and get your site ready to launch."
      />
    </section>
  </main>
  <style is:global>
    summary::after {
      content: '＋';
    }

    details[open] summary::after {
      content: '－';
    }

    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>
</Layout>
