---
import { CALENDLY_URL } from '../lib/site'
import jtbiImage from '../assets/jtbi-mobile.webp'
import supervoidImage from '../assets/supervoid.webp'
import tssImage from '../assets/tss-mobile.webp'
import ClosingCTA from '../components/ui/ClosingCTA.astro'
import CTA from '../components/ui/CTA'
import Link from '../components/ui/Link.tsx'
import Pill from '../components/ui/Pill.astro'
import TextAndImage from '../components/ui/TextAndImage.astro'
import TitleLogo from '../components/ui/TitleLogo.astro'
import Process from '../components/ui/Process.astro'
import Marquee from '../components/layout/Marquee.astro'
import Testimonials from '../components/ui/Testimonials.astro'
import Layout from '../layouts/Layout.astro'
import { sanityClient } from 'sanity:client'
import { TESTIMONIALS_QUERY } from '../sanity/lib/queries'

// Homepage FAQ. Also sent to search and AI answer engines as FAQPage structured data.
// Client quotes for the carousel, edited in Studio (Testimonials)
const testimonialData = await sanityClient.fetch(TESTIMONIALS_QUERY)

const faqs = [
  {
    question: 'Do you work white-label?',
    answer: "Yes. I can work under your agency's name, join client calls as part of your team, or stay behind the scenes.",
  },
  {
    question: 'Can you build from our designs?',
    answer:
      "Yes. I build from your team's Figma files and flag anything that won't hold up in production before it's built. When a project needs design help, I can cover that too.",
  },
  {
    question: 'Which platforms do you build on?',
    answer:
      'Whatever your client already uses. I work in WordPress, Webflow, Shopify, HubSpot, Squarespace, Wix and more. When a project calls for a custom build, my premium option is SanityPress, built on Astro and Sanity.',
  },
  {
    question: 'What is SanityPress?',
    answer:
      'My premium CMS setup, built on Sanity. Each client gets a control center shaped around how they actually work. The things they update most come first, pages are built from a kit of flexible blocks, and the system underneath is proven across multiple builds. It costs more up front. In return, your client runs their own site, and it grows with them.',
  },
  {
    question: "What's included in every build?",
    answer:
      'Fast load times, accessibility (semantic markup, keyboard support, readable contrast), and SEO (clean metadata, structured data, sitemaps and redirects), so both search engines and AI answer engines can read the site.',
  },
  {
    question: 'What does a project cost?',
    answer:
      'It depends on the pages, the platform and how much your client will edit. The estimate comes with the scope outline, after the discovery call.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}
---

<Layout title="Wave Land | Development Partner for Brand Agencies" schema={[faqSchema]}>
  <header class="h-[80svh] md:h-[calc(100dvh-3rem)] max-h-[1200px] pt-[var(--nav-height)] flex flex-col justify-between gap-12">
    <div>
      <div class="mb-6 hero-in">
        <TitleLogo />
      </div>

      <div class="flex flex-wrap gap-2 md:gap-4">
        <Pill text="Development" class="border-purple text-purple hero-in" style="--i: 1" />
        <Pill text="Strategy" class="border-orange text-orange hero-in" style="--i: 2" />
        <Pill text="Partnership" class="border-green text-green hero-in" style="--i: 3" />
      </div>
    </div>
    <div class="max-w-3xl">
      <h1 class="h3 max-w-[22ch] mb-4 md:mb-6 text-lightGrey hero-in" style="--i: 4">
        A development partner for brand agencies.
      </h1>
      <div class="hero-in" style="--i: 5">
        <CTA tag="link" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" text="Book a 15-Minute Call" size="large" />
      </div>
    </div>
  </header>

  <Marquee />

  <main>
    <section id="introduction">
      <TextAndImage
        title="JTB Imaginative."
        text="An Astro and Sanity portfolio for a brand developer with total content freedom."
        caseStudyUrl="/case-studies/jtb-imaginative/"
        linkText="JTB Imaginative case study"
        image={jtbiImage}
        imageAlt="JTB Imaginative website on a phone"
        color="purple"
        class="py-section"
      />
      <TextAndImage
        title="The Story Shack."
        text="A Webflow site for a creative studio that runs itself."
        caseStudyUrl="/case-studies/the-story-shack/"
        linkText="The Story Shack case study"
        image={tssImage}
        isReversed={true}
        imageAlt="The Story Shack's Work page on a phone"
        color="orange"
        class="py-section"
      />
      <TextAndImage
        title="Supervoid."
        text="A video-first Astro site for a studio that designs stage shows for touring artists."
        caseStudyUrl="/case-studies/supervoid/"
        linkText="Supervoid case study"
        image={supervoidImage}
        imageAlt="Supervoid website on a phone"
        color="green"
        class="py-section"
      />
      <div class="lsa">
        <Link text="View Case Studies" url="/case-studies/" size="display" />
      </div>
    </section>

    <Process />

    <!-- Founder (Hi, I'm Josh) is hidden while its copy is reworked; restore it here and its import above -->

    <!-- The section keeps the standard section spacing; the tinted panel is its own container inside it -->
    <section id="faq" class="lsa">
      <div class="section-split p-6 md:p-10 lg:p-12 bg-purple/5 rounded-media shadow-md">
        <h2>
          <span class="text-green">Questions</span> Agencies Ask
        </h2>

        <div>
          {
            // One open at a time (name groups them); the first starts open
            faqs.map((faq, i) => (
              <details name="faq" open={i === 0} class="mb-4 group">
                <summary class="flex justify-between gap-4 group-open:text-purple group-open:font-semibold group-hover:text-purple transition duration-(--transition) cursor-pointer">
                  {faq.question}
                </summary>
                <p class="py-4 text-lightGrey text-prose">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- A bordered, left-aligned quote card, so it reads differently from the open, centered sign-off below -->
    <section id="testimonials" class="section-split lsa">
      <h2>What Clients Say</h2>
      <div class="min-w-0">
        <Testimonials data={testimonialData} />
      </div>
    </section>

    <section id="get-started">
      <ClosingCTA
        title="Looking for a Development Partner?"
        description="If your agency needs someone to build what you design, I'd like to hear about it."
      />
    </section>
  </main>
  <style is:global>
    summary::after {
      content: '＋';
    }

    details[open] summary::after {
      content: '－';
    }

    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>
</Layout>
