---
import { CALENDLY_URL } from '../lib/site'
import AppWindowIcon from '../assets/app-window.svg'
import ChartColumnIcon from '../assets/chart-column.svg'
import jtbiImage from '../assets/jtbi-mobile.webp'
import SunsetTwoIcon from '../assets/sunset-2.svg'
import supervoidImage from '../assets/supervoid.webp'
import tssImage from '../assets/tss-mobile.webp'
import ClosingCTA from '../components/ui/ClosingCTA.astro'
import CTA from '../components/ui/CTA'
import Link from '../components/ui/Link.tsx'
import Pill from '../components/ui/Pill.astro'
import TextAndImage from '../components/ui/TextAndImage.astro'
import TitleLogo from '../components/ui/TitleLogo.astro'
import Founder from '../components/ui/Founder.astro'
import Marquee from '../components/layout/Marquee.astro'
import Testimonials from '../components/ui/Testimonials.astro'
import Layout from '../layouts/Layout.astro'
import { testimonials as testimonialData } from '../lib/data/testimonials'

// Homepage FAQ. Also sent to search and AI answer engines as FAQPage structured data.
const faqs = [
  {
    question: 'Do you work white-label?',
    answer:
      "Yes. I can work under your agency's name, join client calls as part of your team, or stay behind the scenes.",
  },
  {
    question: 'Can you build from our designs?',
    answer:
      "Yes. I build from your team's Figma files and flag anything that won't hold up in production before it's built. When a project needs design help, I can cover that too.",
  },
  {
    question: 'Which platforms do you build on?',
    answer:
      'Whatever your client already uses. I work in WordPress, Webflow, Shopify, HubSpot, Squarespace, Wix and more. When a project calls for a custom build, my premium option is SanityPress, built on Astro and Sanity.',
  },
  {
    question: 'What is SanityPress?',
    answer:
      'My premium CMS setup, built on Sanity. Each client gets a control center shaped around how they actually work. The things they update most come first, pages are built from a kit of flexible blocks, and the system underneath is proven across multiple builds. It costs more up front. In return, your client runs their own site, and it grows with them.',
  },
  {
    question: "What's included in every build?",
    answer:
      'Fast load times, accessibility (semantic markup, keyboard support, readable contrast), and SEO and AEO (clean metadata, structured data, sitemaps and redirects), so both search engines and AI answer engines can read the site.',
  },
  {
    question: 'How long does a build take?',
    answer:
      'Usually 4 to 8 weeks, depending on the number of pages and how ready the content is. The timeline goes in the scope outline.',
  },
  {
    question: 'What does a project cost?',
    answer:
      'It depends on what the site needs to do. After a discovery call, I send a scope outline and an estimate, so you know the number before any work starts.',
  },
  {
    question: 'Can our client edit the site themselves?',
    answer:
      'Yes. Every client gets an editing setup matched to their platform. At handoff, I walk their team through it and leave a guide they can keep.',
  },
  {
    question: 'Who owns the site after launch?',
    answer:
      'Whoever we agree on up front, you or your client. The code, content and accounts are handed over to them at launch.',
  },
  {
    question: 'What happens after launch?',
    answer:
      'I stay on for maintenance and updates, billed hourly or through a monthly retainer with rollover hours. Your client is never left without a developer.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}
---

<Layout title="Wave Land | Development Partner for Brand Agencies" schema={[faqSchema]}>
  <header
    class="h-[80svh] md:h-[calc(100dvh-3rem)] max-h-[1200px] pt-[var(--nav-height)] flex flex-col justify-between gap-12"
  >
    <div>
      <div class="mb-6 hero-in">
        <TitleLogo />
      </div>

      <div class="flex flex-wrap gap-2 md:gap-4">
        <Pill text="Development" variant="outline" class="border-purple text-purple hero-in [animation-delay:100ms]" />
        <Pill text="Strategy" variant="outline" class="border-orange text-orange hero-in [animation-delay:200ms]" />
        <Pill text="Partnership" variant="outline" class="border-green text-green hero-in [animation-delay:300ms]" />
      </div>
    </div>
    <div class="max-w-3xl">
      <h1 class="h3 max-w-[22ch] mb-4 md:mb-6 text-lightGrey hero-in [animation-delay:400ms]">A development partner for brand agencies.</h1>
      <div class="hero-in [animation-delay:500ms]">
        <CTA
          tag="link"
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          text="Book a 15-Minute Call"
          size="large"
        />
      </div>
    </div>
  </header>

  <Marquee />

  <main>
    <section id="introduction">
      <TextAndImage
        title="JTB Imaginative."
        text="An Astro and Sanity portfolio for a brand developer who never waits on a developer."
        caseStudyUrl="/case-studies/jtb-imaginative/"
        linkText="JTB Imaginative case study"
        image={jtbiImage}
        imageAlt="JTB Imaginative website on a phone"
        color="purple"
        class="py-8 md:py-16 lg:py-24"
      />
      <TextAndImage
        title="The Story Shack."
        text="A Webflow site for a creative studio that runs itself."
        caseStudyUrl="/case-studies/the-story-shack/"
        linkText="The Story Shack case study"
        image={tssImage}
        isReversed={true}
        imageAlt="The Story Shack's Work page on a phone"
        color="orange"
        class="py-8 md:py-16 lg:py-24"
      />
      <TextAndImage
        title="Supervoid."
        text="A video-first Astro site for a studio that designs stage shows for touring artists."
        caseStudyUrl="/case-studies/supervoid/"
        linkText="Supervoid case study"
        image={supervoidImage}
        imageAlt="Supervoid website on a phone"
        color="green"
        class="py-8 md:py-16 lg:py-24"
      />
      <div class="lsa lsa-slide-up">
        <Link
          text="View Case Studies"
          url="/case-studies/"
          size="display"
        />
      </div>
    </section>

    <section id="about">
      <div class="section-split">
        <div class="h-full">
          <div class="sticky top-[calc(var(--nav-height)+1rem)] flex flex-col gap-6">
            <h2>What I Do</h2>
            <ul class="grid grid-cols-1 gap-4 md:gap-8">
              <li class="lsa lsa-slide-up flex gap-4 items-start">
                <AppWindowIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-purple" />
                <div class="flex flex-col gap-1">
                  <h3 class="h4 text-purple">Development</h3>
                  <p class="text-grey text-prose">Built from your designs, on the platform your client already uses.</p>
                </div>
              </li>
              <li class="lsa lsa-slide-up delay-100 flex gap-4 items-start">
                <ChartColumnIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-orange" />
                <div class="flex flex-col gap-1">
                  <h3 class="h4 text-orange">Strategy</h3>
                  <p class="text-grey text-prose">Platform, CMS and content decisions, made before the build starts.</p>
                </div>
              </li>
              <li class="lsa lsa-slide-up delay-200 flex gap-4 items-start">
                <SunsetTwoIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-green" />
                <div class="flex flex-col gap-1">
                  <h3 class="h4 text-green">Partnership</h3>
                  <p class="text-grey text-prose">White-label or alongside your team, from the first call to after launch.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col gap-6 text-container">
          <p class="h4 py-4 lsa lsa-slide-up">
            Every project starts with the client, not the platform.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            Before I write code, I learn the brand, the content, and who will update the site after
            launch.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            First comes a discovery call with you and your client. Then I write up a scope outline and
            an estimate, and we go over it together until all three of us agree on exactly what's being
            delivered.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            I write most of the code myself and keep third-party libraries to a minimum, so sites stay
            fast and are easy to hand off or maintain.
          </p>
          <p class="h5 py-4 lsa lsa-slide-up">
            Fast, accessible sites your client's team can update without me.
          </p>
        </div>
      </div>
    </section>

    <Founder />

    <!-- The section keeps the standard section spacing; the tinted panel is its own container inside it -->
    <section id="faq" class="lsa lsa-slide-up">
      <div class="section-split p-6 md:p-10 lg:p-12 bg-purple/5 rounded-media shadow-md">
        <h2><span class="text-green">Questions</span> Agencies Ask</h2>

        <div>
          {
            faqs.map((faq) => (
              <details class="mb-4 group">
                <summary class="flex justify-between gap-4 group-open:text-purple group-hover:text-purple transition duration-(--transition) cursor-pointer">
                  {faq.question}
                </summary>
                <p class="py-4 text-lightGrey text-prose">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- A bordered, left-aligned quote card, so it reads differently from the open, centered sign-off below -->
    <section id="testimonials" class="section-split lsa lsa-slide-up">
      <h2>What Clients Say</h2>
      <div class="min-w-0">
        <Testimonials data={testimonialData} />
      </div>
    </section>

    <section id="get-started">
      <ClosingCTA
        title="Looking for a Development Partner?"
        description="If your agency needs someone to build what you design, I'd like to hear about it."
      />
    </section>
  </main>
  <style is:global>
    summary::after {
      content: '＋';
    }

    details[open] summary::after {
      content: '－';
    }

    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>

  <script>
    const details = document.querySelectorAll('details')
    const firstDetail = details[0]

    // Open the first detail by default
    firstDetail.setAttribute('open', '')

    // Close all details that are not targetDetail
    details.forEach((targetDetail) => {
      targetDetail.addEventListener('click', () => {
        details.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute('open')
          }
        })
      })
    })
  </script>
</Layout>
