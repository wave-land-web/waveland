---
import { CALENDLY_URL } from '../lib/site'
import AppWindowIcon from '../assets/app-window.svg'
import ChartColumnIcon from '../assets/chart-column.svg'
import jtbiImage from '../assets/jtbi-mobile.webp'
import lsomImage from '../assets/lsom-mobile.webp'
import SunsetTwoIcon from '../assets/sunset-2.svg'
import supervoidImage from '../assets/supervoid.webp'
import IntroCallCTA from '../components/text/IntroCallCTA.astro'
import Link from '../components/text/Link.tsx'
import Pill from '../components/text/Pill.astro'
import TextAndImage from '../components/text/TextAndImage.astro'
import TitleLogo from '../components/text/TitleLogo.astro'
import Founder from '../components/ui/Founder.astro'
import Marquee from '../components/ui/Marquee.astro'
import Testimonials from '../components/ui/Testimonials.astro'
import Layout from '../layouts/Layout.astro'
import { testimonials as testimonialData } from '../lib/data/testimonials'

const websiteDetails = [
  {
    summary: 'Support After Launch',
    description:
      'I handle maintenance and updates after launch, billed hourly or through a monthly retainer. Unused retainer hours roll over.',
  },
  {
    summary: 'High Performance',
    description:
      'Expect fast load times and seamless performance across all devices, ensuring your visitors have a smooth and satisfying experience.',
  },
  {
    summary: 'Built from Your Designs',
    description:
      "I build from your team's designs and flag anything that won't hold up in production. When a project needs design help, I can cover that too.",
  },
  {
    summary: 'Technical SEO',
    description: 'Clean markup, metadata, sitemaps, and redirects handled before launch.',
  },
  {
    summary: 'Accessible by Default',
    description: 'Semantic markup, keyboard support, and readable contrast.',
  },
  {
    summary: 'A CMS They Can Run',
    description:
      'Every client gets an editing setup matched to their platform, with SanityPress as the premium option.',
  },
]
---

<Layout title="Wave Land | Development Partner for Brand Agencies">
  <header
    class="h-[80svh] md:h-[calc(100dvh-3rem)] max-h-[1200px] pt-[var(--nav-height)] flex flex-col justify-between gap-12"
  >
    <div>
      <div class="mb-6 hero-in">
        <TitleLogo />
      </div>

      <div class="flex flex-wrap gap-2 md:gap-4">
        <Pill text="Development" href="#about-us" class="bg-purple hero-in [animation-delay:100ms]" />
        <Pill text="Strategy" href="#about-us" class="bg-orange hero-in [animation-delay:200ms]" />
        <Pill text="Partnership" href="#about-us" class="bg-green hero-in [animation-delay:300ms]" />
      </div>
    </div>
    <div class="max-w-3xl">
      <h1 class="h3 max-w-[22ch] mb-4 md:mb-6 text-lightGrey hero-in [animation-delay:400ms]">A development partner for brand agencies.</h1>
      <div class="hero-in [animation-delay:500ms]">
        <Link
          text="Book a 15-Minute Call"
          url={CALENDLY_URL}
          newWindow={true}
          size="lead"
        />
      </div>
    </div>
  </header>

  <Marquee />

  <main>
    <section id="introduction">
      <TextAndImage
        title="Carve your path."
        text="Your website should be a true extension of your creativity—giving you more freedom to focus on what you love."
        caseStudyUrl="/case-studies/supervoid/"
        linkText="supervoid.tv"
        image={supervoidImage}
        imageAlt="Supervoid website on a mobile device"
        color="purple"
        class="py-8 md:py-16 lg:py-24"
      />
      <TextAndImage
        title="Fuel your creativity."
        text="Spend more time making, sharing, and growing, without getting bogged down by technical hurdles."
        caseStudyUrl="/case-studies/jtb-imaginative/"
        linkText="jtbimaginative.com"
        image={jtbiImage}
        isReversed={true}
        imageAlt="JTB Imaginative website on a mobile device"
        color="orange"
        class="py-8 md:py-16 lg:py-24"
      />
      <TextAndImage
        title="Amplify your impact."
        text="A thoughtful, user-first website that strengthens your brand, builds trust and inspires action."
        caseStudyUrl="/case-studies/lymphatic-specialists-of-madison/"
        linkText="lymphaticspecialistsofmadison.com"
        image={lsomImage}
        imageAlt="Lymphatic Specialists of Madison website on a mobile device"
        color="green"
        class="py-8 md:py-16 lg:py-24"
      />
      <div class="lsa lsa-slide-up">
        <Link
          text="View Case Studies"
          url="/case-studies/"
          size="display"
        />
      </div>
    </section>

    <section id="about-us">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-16">
        <div class="h-full">
          <div class="sticky top-[calc(var(--nav-height)+1rem)] flex flex-col gap-6">
            <h2>What I Do</h2>
            <ul class="grid grid-cols-1 gap-4 md:gap-8">
              <li class="lsa lsa-slide-up flex gap-4 items-center">
                <AppWindowIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-purple" />
                <h3 class="h4 text-purple">Development</h3>
              </li>
              <li class="lsa lsa-slide-up delay-100 flex gap-4 items-center">
                <ChartColumnIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-orange" />
                <h3 class="h4 text-orange">Strategy</h3>
              </li>
              <li class="lsa lsa-slide-up delay-200 flex gap-4 items-center">
                <SunsetTwoIcon class="flex-shrink-0 w-8 md:w-10 h-auto stroke-2 text-green" />
                <h3 class="h4 text-green">Partnership</h3>
              </li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col gap-6 text-container">
          <p class="h4 py-4 lsa lsa-slide-up">
            Every project starts with the client, not the platform.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            Before I write code, I learn the brand, the content, and who will update the site after
            launch.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            It starts with a discovery call with you and your client. Then I write up a scope outline
            and an estimate, and we go over it together until you, your client, and I agree on exactly
            what's being delivered.
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            I write most of the code myself and keep third-party libraries to a minimum, so sites stay
            fast and are easy to hand off or maintain.
          </p>
          <p class="lsa lsa-slide-up">
            <strong><em>Everything you need, nothing you don't.</em></strong>
          </p>
          <p class="text-lightGrey lsa lsa-slide-up">
            After launch, I stay on for maintenance and updates, billed hourly or through a monthly
            retainer with rollover hours. Your client is never left without a developer.
          </p>
          <p class="h5 py-4 lsa lsa-slide-up">
            Fast, accessible sites your client's team can update without me.
          </p>
        </div>
      </div>
    </section>

    <Founder />

    <section
      id="website-details"
      class="lsa lsa-slide-up p-6 md:p-8 bg-purple/5 rounded-2xl shadow-md"
    >
      <div class="grid gap-8 md:gap-16 md:grid-cols-2">
        <h2><span class="text-green">What Every Build</span> Includes</h2>

        <div>
          {
            websiteDetails.map((detail) => (
              <details class="mb-4 group">
                <summary class="flex justify-between gap-4 group-open:text-purple group-hover:text-purple transition duration-(--transition) cursor-pointer">
                  {detail.summary}
                </summary>
                <p class="py-4 text-lightGrey text-prose">{detail.description}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="testimonials" class="max-w-screen-md m-auto text-center lsa lsa-slide-up">
      <h2 class="mb-8">What Clients Say</h2>
      <Testimonials data={testimonialData} />
    </section>

    <section id="get-started">
      <IntroCallCTA
        title="Looking for a Development Partner?"
        description="If your agency needs someone to build what you design, I'd like to hear about it."
        linkText="Book a 15-Minute Call"
        linkSrc={CALENDLY_URL}
      />
    </section>
  </main>
</Layout>

<style is:global>
  summary::after {
    content: '＋';
  }

  details[open] summary::after {
    content: '－';
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  const details = document.querySelectorAll('details')
  const firstDetail = details[0]

  // Open the first detail by default
  firstDetail.setAttribute('open', '')

  // Close all details that are not targetDetail
  details.forEach((targetDetail) => {
    targetDetail.addEventListener('click', () => {
      details.forEach((detail) => {
        if (detail !== targetDetail) {
          detail.removeAttribute('open')
        }
      })
    })
  })
</script>
