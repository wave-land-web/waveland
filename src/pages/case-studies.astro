---
import { sanityClient } from 'sanity:client'
import ClosingCTA from '../components/ui/ClosingCTA.astro'
import CaseStudyCard from '../components/case-study/CaseStudyCard.astro'
import PageHeader from '../components/layout/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
import Marquee from '../components/layout/Marquee.astro'
import { platformTags } from '../lib/text'
import { CASE_STUDIES_QUERY } from '../sanity/lib/queries'

// Fetch all case studies, plus the order set in Studio (Case Study Order)
const { caseStudies, order } = await sanityClient.fetch(CASE_STUDIES_QUERY)

// Ordered ones first, in the Studio order; the rest after them, newest first (the query's order)
const rank = new Map((order ?? []).map((id, i) => [id, i]))
const sorted = [...caseStudies].sort((a, b) => (rank.get(a._id) ?? Infinity) - (rank.get(b._id) ?? Infinity))

// Filters: one per platform, most case studies first. "Astro + Sanity" counts under both Astro and Sanity.
// Only platforms with a published case study get a filter, so a filter never comes up empty.
const counts = new Map<string, number>()
for (const { platform } of caseStudies) {
  for (const tag of platformTags(platform)) counts.set(tag, (counts.get(tag) ?? 0) + 1)
}
const filters = [
  ['all', 'All', caseStudies.length],
  ...[...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([tag, count]) => [tag, tag, count]),
] as [string, string, number][]
---

<Layout
  title="Case Studies | Wave Land"
  description="Case studies from Josh Nussbaum, a development partner for creative agencies and the businesses they serve: what each project needed, how it was built, and how it turned out."
>
  <PageHeader
    title="Selected Work"
    subtitle="Case Studies"
    align="left"
    bodyText="Projects built with agency partners and directly with clients. What each one needed, the architecture, and how it turned out."
  />

  <main>
    <!-- Filters are buttons, so they only show once the script that runs them is here (see below). They rise in one after another, after the header. -->
    <div id="case-study-filters" role="group" aria-label="Filter case studies by platform" class="hidden flex-wrap gap-3 mb-12">
      {filters.map(([value, label, count], i) => (
        <button
          type="button"
          class="btn btn-toggle text-label px-4 py-2 hero-in"
          style={`--i: ${i + 1}`}
          data-filter={value}
          aria-pressed={value === 'all' ? 'true' : 'false'}
        >
          {label} <span class="opacity-60">{count}</span>
        </button>
      ))}
    </div>
    <p id="case-study-filter-status" class="sr-only" aria-live="polite"></p>
    <section id="case-studies" class="grid lg:grid-cols-2 gap-x-12 gap-y-20 pt-0">
      {sorted.map((caseStudy, i) => (
        <CaseStudyCard caseStudy={caseStudy} priority={i === 0} featured={i === 0} />
      ))}
    </section>
    <section id="get-started">
      <ClosingCTA title="Working on Something Like This?" description="Tell me what you're working on. I reply within 48 hours." />
    </section>
  </main>
  <Marquee />
</Layout>

<script>
  const bar = document.getElementById('case-study-filters')
  const status = document.getElementById('case-study-filter-status')
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#case-study-filters [data-filter]')]
  const cards = [...document.querySelectorAll<HTMLElement>('#case-studies [data-platforms]')]

  // The filter in the URL (?platform=Webflow), or 'all' when there's none or it isn't one of the buttons
  function filterFromUrl() {
    const platform = new URL(location.href).searchParams.get('platform')
    return platform && buttons.some((button) => button.dataset.filter === platform) ? platform : 'all'
  }

  // Show the cards for one platform ('all' for every card)
  function apply(filter: string) {
    let shown = 0
    cards.forEach((card) => {
      const match = filter === 'all' || (card.dataset.platforms ?? '').split(' ').includes(filter)
      card.hidden = !match
      if (match) {
        shown++
        card.classList.add('active') // skip the scroll reveal; the filter change is the motion
      }
    })
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)))
    if (status)
      status.textContent = `Showing ${shown} case ${shown === 1 ? 'study' : 'studies'}${filter === 'all' ? '' : ` built with ${filter}`}`
  }

  // Cards glide to their new places where view transitions are supported
  function show(filter: string) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    if (!document.startViewTransition || reduce) return apply(filter)
    // Name every card for this transition only (a name each), then clear them
    const name = (on: boolean) =>
      cards.forEach((card, i) => {
        card.style.viewTransitionName = on ? `case-${i}` : ''
        card.style.viewTransitionClass = on ? 'move' : ''
      })
    name(true)
    document.startViewTransition(() => apply(filter)).finished.finally(() => name(false))
  }

  if (bar && cards.length > 0) {
    bar.classList.replace('hidden', 'flex')

    // Each choice is a step in the history, so Back returns to the previous filter, and the URL can be shared
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all'
        if (filter === filterFromUrl()) return
        const url = new URL(location.href)
        if (filter === 'all') url.searchParams.delete('platform')
        else url.searchParams.set('platform', filter)
        history.pushState(null, '', url)
        show(filter)
      }),
    )
    // Back and Forward switch instantly: a view transition started during a history step can stall in Chrome
    // (after returning from a case study, its update never ran and the page kept the old filter)
    window.addEventListener('popstate', () => apply(filterFromUrl()))

    // A shared link like ?platform=Webflow opens filtered
    if (filterFromUrl() !== 'all') apply(filterFromUrl())
  }
</script>
