---
import type { SanityDocument } from '@sanity/client'
import { sanityClient } from 'sanity:client'
import CaseStudyCard from '../components/ui/CaseStudyCard.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
import Marquee from '../components/ui/Marquee.astro'

// Fetch all case studies
const caseStudies = (await sanityClient.fetch(
  `*[_type == "case-study"] | order(publishedAt desc) {
    title,
    slug,
    mainImage,
    publishedAt,
    description,
    services,
  }`,
)) as SanityDocument[]
---

<Layout
  title="Case Studies | Wave Land"
  description="Case studies from Josh Nussbaum: Astro and Sanity, Webflow, Shopify, and Wix builds, with the decisions behind them."
>
  <PageHeader
    title="Case Studies"
    subtitle="Recent Work"
    bodyText="Projects built with agency partners and directly with clients. What each one needed, the architecture, and how it turned out."
  />

  <main class="lg:max-w-screen-xl">
    <section id="case-studies" class="grid lg:grid-cols-2 gap-24 pt-4">
      {
        caseStudies.map((caseStudy, i) => (
          <CaseStudyCard caseStudy={caseStudy} priority={i === 0} />
        ))
      }
    </section>
  </main>
  <Marquee />
</Layout>
