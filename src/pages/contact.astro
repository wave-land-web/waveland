---
import { CALENDLY_URL, EMAIL, EMAIL_HREF } from '../lib/site'
import { Icon } from 'astro-icon/components'
import CTA from '../components/ui/CTA'
import PageHeader from '../components/layout/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
import Marquee from '../components/layout/Marquee.astro'

const fieldClass =
  'block w-full backdrop-blur-sm bg-white/1 border border-dashed border-darkGrey hover:border-purple rounded-field px-4 py-3 shadow-md transition duration-(--transition) focus:outline-none focus:border-purple'
const labelClass = 'block mb-2 text-left text-label text-lightGrey'
// Selects show their first option as a placeholder, in the same grey as the inputs' placeholders
const selectClass = `${fieldClass} appearance-none pr-10 text-left cursor-pointer invalid:text-lightGrey/50 [&:has(option[value='']:checked)]:text-lightGrey/50 [&_option]:text-black`
---

<Layout
  title="Contact | Wave Land"
  description="Tell me about your project, or book a 15-minute call. I'm Josh Nussbaum, a development partner for creative agencies and the businesses they serve."
>
  <PageHeader
    title="Contact"
    subtitle="Tell Me About Your Project"
    bodyText="A rough idea is enough to start. I'll reply by email within 48 hours."
  />

  <main>
    <section class="pt-0 text-center hero-in" style="--i: 1">
      <!-- Posts to /api/contact, which sends it to HubSpot (with a backup copy in Netlify Forms) and redirects to /success/, or back here with ?error -->
      <form method="POST" name="contactForm" action="/api/contact" class="max-w-copy m-auto flex flex-col gap-6">
        <!-- Shown by the script below when the API sends someone back with ?error -->
        <p id="form-error" role="alert" class="hidden text-orange text-left"></p>
        <!-- Honeypot: hidden from people; bots fill it and /api/contact quietly drops the submission -->
        <p class="hidden" aria-hidden="true">
          <label>
            Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="w-full flex flex-col md:flex-row gap-6 md:gap-4 justify-between">
          <div class="w-full">
            <label for="first-name" class={labelClass}>
              First Name
            </label>
            <input type="text" name="first-name" id="first-name" autocomplete="given-name" required class={fieldClass} />
          </div>

          <div class="w-full">
            <label for="last-name" class={labelClass}>
              Last Name <span class="text-grey">(Optional)</span>
            </label>
            <input type="text" name="last-name" id="last-name" autocomplete="family-name" class={fieldClass} />
          </div>
        </div>
        <div>
          <label for="email" class={labelClass}>
            Email
          </label>
          <input type="email" name="email" id="email" autocomplete="email" placeholder="you@example.com" required class={fieldClass} />
        </div>

        <div class="w-full flex flex-col md:flex-row gap-6 md:gap-4 justify-between">
          <div class="w-full">
            <label for="role" class={labelClass}>
              I'm Reaching Out As
            </label>
            <div class="relative">
              <select name="role" id="role" required class={selectClass}>
                <option value="" disabled selected>
                  Choose one
                </option>
                <option>An agency</option>
                <option>A business or organization</option>
                <option>Something else</option>
              </select>
              <Icon
                name="tabler:chevron-down"
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
                aria-hidden="true"
              />
            </div>
          </div>

          <div class="w-full">
            <label for="website" class={labelClass}>
              Current Website <span class="text-grey">(Optional)</span>
            </label>
            <input
              type="text"
              inputmode="url"
              name="website"
              id="website"
              autocomplete="url"
              placeholder="example.com"
              class={fieldClass}
            />
          </div>
        </div>

        <div class="w-full flex flex-col md:flex-row gap-6 md:gap-4 justify-between">
          <div class="w-full">
            <label for="budget" class={labelClass}>
              Budget <span class="text-grey">(Optional)</span>
            </label>
            <div class="relative">
              <select name="budget" id="budget" class={selectClass}>
                <option value="" selected>
                  Choose one
                </option>
                <option>Under $5k</option>
                <option>$5k to $15k</option>
                <option>$15k to $30k</option>
                <option>$30k or more</option>
                <option>Not sure yet</option>
              </select>
              <Icon
                name="tabler:chevron-down"
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
                aria-hidden="true"
              />
            </div>
          </div>

          <div class="w-full">
            <label for="timeline" class={labelClass}>
              Timeline <span class="text-grey">(Optional)</span>
            </label>
            <div class="relative">
              <select name="timeline" id="timeline" class={selectClass}>
                <option value="" selected>
                  Choose one
                </option>
                <option>As soon as possible</option>
                <option>In 1 to 3 months</option>
                <option>In 3 months or more</option>
                <option>Flexible</option>
              </select>
              <Icon
                name="tabler:chevron-down"
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>

        <div>
          <label for="message" class={labelClass}>
            What Are You Working On?
          </label>
          <textarea
            name="message"
            id="message"
            rows="4"
            placeholder="The platform, the launch date, anything you know so far."
            required
            class={fieldClass}
          ></textarea>
        </div>

        <CTA tag="button" type="submit" text="Send Message" className="w-fit mx-auto" />
      </form>
    </section>

    <section class="lsa">
      <div class="max-w-copy m-auto text-center">
        <h2 class="mb-4">Prefer to Talk?</h2>

        <div class="flex flex-col gap-6 items-center">
          <CTA tag="link" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" text="Book a 15-Minute Call" variant="secondary" />
          <!-- Email Link -->
          <a href={EMAIL_HREF} class="inline-flex gap-2 items-center text-grey hover:text-purple">
            <Icon name="tabler:mail" />
            {EMAIL}
          </a>
        </div>
      </div>
    </section>

    <Marquee />
  </main>
</Layout>

<script>
  import { EMAIL } from '../lib/site'

  // /api/contact sends people back here with ?error when a message didn't go through
  const errors: Record<string, string> = {
    missing: 'Please fill in your name, email, who you are and your message.',
    email: 'Please check your email address. It should look like you@example.com.',
    send: `Your message didn't send. Please try again, or email me at ${EMAIL}.`,
  }
  const error = new URL(location.href).searchParams.get('error')
  const form = document.querySelector<HTMLFormElement>('form[name="contactForm"]')
  const box = document.getElementById('form-error')
  const key = 'contact-draft'

  // What they typed is kept for this tab only, so an error never means typing a long message again
  form?.addEventListener('submit', () => {
    const draft = Object.fromEntries([...new FormData(form)].filter(([name]) => name !== 'bot-field'))
    try {
      sessionStorage.setItem(key, JSON.stringify(draft))
    } catch {}
  })

  if (error && form && box) {
    box.textContent = Object.hasOwn(errors, error) ? errors[error] : errors.send
    box.classList.remove('hidden')
    try {
      const draft: Record<string, string> = JSON.parse(sessionStorage.getItem(key) ?? '{}')
      for (const [name, value] of Object.entries(draft)) {
        const field = form.elements.namedItem(name)
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)
          field.value = value
      }
    } catch {}
  } else {
    // A fresh visit (or after a message went through) starts empty
    try {
      sessionStorage.removeItem(key)
    } catch {}
  }
</script>
