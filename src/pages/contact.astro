---
import { CALENDLY_URL, EMAIL, EMAIL_HREF } from '../lib/site'
import { Icon } from 'astro-icon/components'
import CTA from '../components/text/CTA'
import PageHeader from '../components/ui/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
import Marquee from '../components/ui/Marquee.astro'

const fieldClass =
  'block w-full backdrop-blur-sm bg-white/1 border border-dashed border-darkGrey hover:border-purple rounded-lg px-4 py-3 shadow-md transition duration-(--transition) focus:outline-none focus:border-purple'
// Selects show their first option as a placeholder, in the same grey as the inputs' placeholders
const selectClass = `${fieldClass} appearance-none pr-10 text-left cursor-pointer invalid:text-lightGrey/50 [&:has(option[value='']:checked)]:text-lightGrey/50 [&_option]:text-black`
---

<Layout
  title="Contact | Wave Land"
  description="Tell me about your project, or book a 15-minute call. I'm Josh Nussbaum, a development partner for brand agencies."
>
  <PageHeader
    title="Contact"
    subtitle="Tell Me About Your Project"
    bodyText="A rough idea is enough to start. If you know the platform or the launch date, include it. I'll reply by email within 48 hours."
  />

  <main>
    <section class="pt-0 text-center lsa lsa-slide-up">
      <form
        method="POST"
        name="contactForm"
        action="/success/"
        class="max-w-2xl m-auto flex flex-col gap-4"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <!-- Honeypot: hidden from people, bots fill it and Netlify drops the submission -->
        <p class="hidden" aria-hidden="true">
          <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="w-full flex flex-col md:flex-row gap-4 justify-between">
          <div class="w-full">
            <label for="first-name" class="sr-only">First Name</label>
            <input
              type="text"
              name="first-name"
              id="first-name"
              autocomplete="given-name"
              placeholder="First Name"
              required
              class={fieldClass}
            />
          </div>

          <div class="w-full">
            <label for="last-name" class="sr-only">Last Name</label>
            <input
              type="text"
              name="last-name"
              id="last-name"
              autocomplete="family-name"
              placeholder="Last Name (Optional)"
              class={fieldClass}
            />
          </div>
        </div>
        <div>
          <label for="email" class="sr-only">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            placeholder="Email"
            required
            class={fieldClass}
          />
        </div>

        <div class="w-full flex flex-col md:flex-row gap-4 justify-between">
          <div class="w-full relative">
            <label for="role" class="sr-only">I'm Reaching Out As</label>
            <select name="role" id="role" required class={selectClass}>
              <option value="" disabled selected>I'm reaching out as…</option>
              <option>An agency</option>
              <option>A business or organization</option>
              <option>Something else</option>
            </select>
            <Icon
              name="tabler:chevron-down"
              class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
              aria-hidden="true"
            />
          </div>

          <div class="w-full">
            <label for="company" class="sr-only">Agency or Company</label>
            <input
              type="text"
              name="company"
              id="company"
              autocomplete="organization"
              placeholder="Company (Optional)"
              class={fieldClass}
            />
          </div>
        </div>

        <div class="w-full flex flex-col md:flex-row gap-4 justify-between">
          <div class="w-full relative">
            <label for="budget" class="sr-only">Budget</label>
            <select name="budget" id="budget" class={selectClass}>
              <option value="" selected>Budget (Optional)</option>
              <option>Under $5k</option>
              <option>$5k to $15k</option>
              <option>$15k to $30k</option>
              <option>$30k or more</option>
              <option>Not sure yet</option>
            </select>
            <Icon
              name="tabler:chevron-down"
              class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
              aria-hidden="true"
            />
          </div>

          <div class="w-full relative">
            <label for="timeline" class="sr-only">Timeline</label>
            <select name="timeline" id="timeline" class={selectClass}>
              <option value="" selected>Timeline (Optional)</option>
              <option>As soon as possible</option>
              <option>In 1 to 3 months</option>
              <option>In 3 months or more</option>
              <option>Flexible</option>
            </select>
            <Icon
              name="tabler:chevron-down"
              class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-grey"
              aria-hidden="true"
            />
          </div>
        </div>

        <div>
          <label for="website" class="sr-only">Current Website</label>
          <input
            type="text"
            inputmode="url"
            name="website"
            id="website"
            autocomplete="url"
            placeholder="Current Website (Optional)"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="message" class="sr-only">Describe Your Project</label>
          <textarea
            name="message"
            id="message"
            rows="4"
            placeholder="What are you building?"
            required
            class={fieldClass}
          ></textarea>
        </div>

        <CTA
          tag="button"
          type="submit"
          text="Send Message"
          aria-label="Send Message"
          title="Send Message"
          className="w-fit mx-auto"
        />
      </form>
    </section>

    <section class="lsa lsa-slide-up">
      <div class="max-w-2xl m-auto text-center">
        <h2 class="mb-4">Prefer to Talk?</h2>

        <div class="flex flex-col gap-6 items-center">
          <!-- Calendly Link -->
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex gap-2 items-center text-grey hover:text-purple"
            ><Icon name="tabler:calendar" />Book a 15-Minute Call
          </a>
          <!-- Email Link -->
          <a
            href={EMAIL_HREF}
            aria-label="Email"
            title="Email"
            class="inline-flex gap-2 items-center text-grey hover:text-purple"
            ><Icon name="tabler:mail" />{EMAIL}
          </a>
        </div>
      </div>
    </section>

    <Marquee />
  </main>
</Layout>
