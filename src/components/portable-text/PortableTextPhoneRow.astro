---
import { urlForImage } from '../../sanity/lib/urlForImage'

const { images } = Astro.props.node // `.node` is the current node in the PortableText

// One caption for the row, joined from every image that has one
const caption = images
  .map((image: { caption?: string }) => image.caption?.trim())
  .filter(Boolean)
  .join(' ')
const widths = [240, 360, 480, 720]
// Each shot is a third of the column (md and up), so rows of one or two stay phone-sized and centered
---

<figure class="case-study-figure">
  <!-- Phones: a swipeable row that bleeds to the screen edges, with the next shot peeking in. md and up: three across. -->
  <div
    class="phone-row flex gap-3 overflow-x-auto snap-x snap-mandatory -mx-4 px-4 scroll-px-4 [justify-content:safe_center] md:gap-4 md:mx-0 md:px-0 md:overflow-visible"
  >
    {
      images.map(({ asset, alt }: { asset: { _ref: string }; alt?: string }) => {
        const [, width = 1170, height = 2532] = asset._ref.match(/-(\d+)x(\d+)-/)?.map(Number) ?? []
        return (
          <button
            type="button"
            class="zoomable shrink-0 w-[62%] snap-center md:shrink md:w-[calc((100%-2rem)/3)]"
            data-zoom={urlForImage(asset).width(Math.min(width, 1200)).auto('format').url()}
            aria-label={`Enlarge image: ${alt}`}
          >
            <img
              src={urlForImage(asset).width(360).auto('format').url()}
              srcset={widths
                .filter((w) => w <= width)
                .map((w) => `${urlForImage(asset).width(w).auto('format').url()} ${w}w`)
                .join(', ')}
              sizes="(min-width: 1024px) 240px, (min-width: 768px) calc((100vw - 6rem) * 2 / 9), 62vw"
              width={width}
              height={height}
              alt={alt}
              decoding="async"
              loading="lazy"
              class="w-full h-auto rounded-media"
            />
          </button>
        )
      })
    }
  </div>
  {caption && <figcaption class="mt-3 text-label text-grey">{caption}</figcaption>}
</figure>

<style>
  /* The row scrolls by swipe; a scrollbar under the screenshots only adds noise */
  .phone-row {
    scrollbar-width: none;
  }

  .phone-row::-webkit-scrollbar {
    display: none;
  }
</style>
