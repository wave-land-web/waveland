---
// A case study H2 with an id, so the table of contents can link to it
import { blockText, headingId } from '../../lib/text'

const { node } = Astro.props
---

<!-- tabindex lets the table of contents move focus here after scrolling to it -->
<h2 id={headingId(blockText(node))} tabindex="-1" class="scroll-mt-15 outline-none"><slot /></h2>
