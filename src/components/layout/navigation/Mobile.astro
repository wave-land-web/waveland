---
import { Icon } from 'astro-icon/components'
import TitleLogo from '@wave-land-web/design/components/TitleLogo.astro'
import SocialIcons from '../../ui/SocialIcons.astro'
---

<!-- Mobile nav -->
<button
  id="menu"
  type="button"
  aria-expanded="false"
  aria-controls="mobile-nav-overlay"
  class="flex items-center gap-2 z-30 md:hidden hover:text-purple transition-all duration-(--transition) ease-in-out cursor-pointer"
>
  <span class="label">Menu</span>
  <Icon name="tabler:menu" />
  <Icon name="tabler:x" class="hidden" />
</button>

<div
  id="mobile-nav-overlay"
  class="absolute pt-[var(--nav-height)] top-0 left-0 z-20 overflow-y-auto h-screen w-full px-4 hidden flex-col items-start bg-darkBlue"
>
  <TitleLogo class="mb-8" />
  <ul id="mobile-nav-items" class="w-full">
    <li class="w-full py-6 border-y border-dashed border-darkGrey">
      <a href="/#about" class="label">
        About
      </a>
    </li>
    <li class="w-full py-6 border-b border-dashed border-darkGrey">
      <a href="/case-studies/" data-nav="case-studies" class="label">
        Case Studies
      </a>
    </li>
    <li class="w-full py-6 border-b border-dashed border-darkGrey">
      <a href="/contact/" data-nav="contact" class="label">
        Contact
      </a>
    </li>
    <li class="w-full py-6 border-b border-dashed border-darkGrey">
      <SocialIcons color="text-white" />
    </li>
  </ul>
</div>

{/* While the menu is open, the page behind it is inert, so it can't be focused or read by screen readers. Esc closes it. */}
<script is:inline>
  const menu = document.querySelector('#menu')
  const menuIconOpen = document.querySelector('[data-icon="tabler:menu"]')
  const menuIconClose = document.querySelector('[data-icon="tabler:x"]')
  const menuText = document.querySelector('#menu span')
  const mobileNavOverlay = document.querySelector('#mobile-nav-overlay')
  const mobileNavItems = document.querySelectorAll('#mobile-nav-items a')
  let menuOpen = false

  function setMenuOpen(open) {
    menuOpen = open
    mobileNavOverlay?.classList.toggle('hidden', !open)
    mobileNavOverlay?.classList.toggle('flex', open)
    menu?.setAttribute('aria-expanded', `${open}`)
    document.querySelectorAll('body > :not(nav)').forEach((el) => (el.inert = open))
    menuText.textContent = open ? 'CLOSE' : 'MENU'
    menuIconOpen?.classList.toggle('hidden', open)
    menuIconClose?.classList.toggle('hidden', !open)
  }

  document.body.addEventListener('keyup', (event) => {
    if (event.code === 'Escape' && menuOpen) {
      setMenuOpen(false)
      menu?.focus()
    }
  })

  menu?.addEventListener('click', () => setMenuOpen(!menuOpen))
  window.addEventListener('resize', () => {
    if (menuOpen && window.innerWidth >= 768) setMenuOpen(false)
  })
  mobileNavItems.forEach((item) => item.addEventListener('click', () => setMenuOpen(false)))
</script>
