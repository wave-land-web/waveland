---
import Link from '../ui/Link.tsx'

export interface Props {
  // Small line above the h1; leave it out when it would repeat the h1
  title?: string
  subtitle: string
  // 'left' lines the header up with a full-width grid below it
  align?: 'center' | 'left'
  bodyText?: string
  linkText?: string
  linkUrl?: string
}

const { title, subtitle, bodyText, linkText, linkUrl, align = 'center' } = Astro.props

const alignClasses = {
  center: 'max-w-copy items-center text-center',
  left: 'items-start text-left',
}
---

<header class:list={[alignClasses[align], 'mb-header pt-page-top stack justify-center hero-in']}>
  {title && <p class="font-header text-purple text-prose">{title}</p>}
  <h1>{subtitle}</h1>
  {bodyText && <p class="max-w-narrow mb-4 text-lightGrey">{bodyText}</p>}
  {linkText && linkUrl && <Link text={linkText} url={linkUrl} />}
  <slot />
</header>
