---
// Logos load as image files, cached once across pages. Inlined, they added ~300 KB to every page.
// Not lazy: the strip scrolls sideways, and lazy logos outside the viewport would slide in blank.
const files = import.meta.glob<string>('../../assets/logos/*.svg', { eager: true, query: '?url', import: 'default' })
const sources = import.meta.glob<string>('../../assets/logos/*.svg', { eager: true, query: '?raw', import: 'default' })

// Every logo covers about this many square pixels
const AREA = 5200

// Big brands from in-house and agency work, mixed with case study clients
const logos = [
  { slug: 'loreal', name: "L'Oréal" },
  { slug: 'jtb-imaginative', name: 'JTB Imaginative' },
  { slug: 'aaa', name: 'AAA' },
  { slug: 'supervoid', name: 'Supervoid' },
  { slug: 'church-dwight', name: 'Church & Dwight' },
  { slug: 'the-story-shack', name: 'The Story Shack' },
  { slug: 'la-roche-posay', name: 'La Roche-Posay' },
  { slug: 'lymphatic-specialists-of-madison', name: 'Lymphatic Specialists of Madison' },
  { slug: 'pmi', name: 'PMI' },
  { slug: 'frame-bio', name: 'Frame Bio' },
  { slug: 'born-yesterday-bakery', name: 'Born Yesterday Bakery' },
  { slug: 'robby-webb', name: 'Robby Webb' },
  { slug: 'ocean-avenue-stompers', name: 'Ocean Avenue Stompers' },
].map((logo) => {
  const path = `../../assets/logos/${logo.slug}.svg`
  // Size every logo to the same area, not the same box, so a wide wordmark isn't tiny next to a round badge.
  // Width comes from the viewBox's aspect ratio; heights are capped so square marks don't tower.
  const [, , vbWidth, vbHeight] = (sources[path].match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1 1').split(/[\s,]+/).map(Number)
  const ratio = vbWidth / vbHeight
  const height = Math.min(Math.sqrt(AREA / ratio), 72)
  const width = Math.min(height * ratio, 220)
  return { ...logo, src: files[path], width: Math.round(width), height: Math.round(width / ratio) }
})
---

<div class="marquee-wrapper container md:max-w-screen-3xl">
  <!-- No visible label; screen readers still get one -->
  <h2 class="sr-only">Brands I’ve built for</h2>
  <div class="marquee">
    <!-- Two identical strips so the loop is seamless; the copy is hidden from screen readers -->
    {
      [false, true].map((copy) => (
        <div class="marquee-content" aria-hidden={copy ? 'true' : undefined}>
          {logos.map((logo) => (
            <img src={logo.src} alt={copy ? '' : logo.name} width={logo.width} height={logo.height} style={`--w: ${logo.width}`} fetchpriority="low" decoding="async" />
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee-wrapper {
    --gap: clamp(4rem, 10vw, 6rem);
    --duration: 30s;
    padding: 4rem 0;
    margin: 0 auto;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      var(--color-black) 20%,
      var(--color-black) 80%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      var(--color-black) 20%,
      var(--color-black) 80%,
      transparent
    );
  }

  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: var(--gap);
  }

  .marquee-content {
    flex-shrink: 0;
    display: flex;
    justify-content: space-around;
    gap: var(--gap);
    min-width: 100%;
    animation: scroll var(--duration) linear infinite;
  }

  /* Hovering stops the logos so they can be read; reduced motion keeps them still */
  .marquee:hover .marquee-content {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation-play-state: paused;
    }
  }

  /* --w is the logo's width at full size (set per logo above); below a 1000px viewport logos shrink, to 75% at most */
  .marquee-content img {
    align-self: center;
    width: clamp(calc(var(--w) * 0.75px), calc(var(--w) * 0.1vw), calc(var(--w) * 1px));
    height: auto;
    flex-shrink: 0;
    border-radius: 0;
    filter: none;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }
</style>
