---
import TitleLogo from '../ui/TitleLogo.astro'
import SocialIcons from '../ui/SocialIcons.astro'
---

<footer class="pt-4 pb-8 border-t border-dashed border-darkGrey">
  <div id="wrapper" class="m-auto mb-8 pt-5">
    <div id="info">
      <TitleLogo class="max-w-96" />
      <p class="max-w-copy mb-4 text-prose text-lightGrey">
        <em>Wave Land is Josh Nussbaum, a web developer in Madison, WI, and a development partner for brand agencies.</em>
      </p>
    </div>
  </div>
  <div class="flex flex-col md:flex-row justify-between gap-4 m-auto">
    <SocialIcons color="text-grey" />
    <p class="text-grey lg:text-end text-label">wavelandweb.com © {new Date().getFullYear()}</p>
  </div>
</footer>
