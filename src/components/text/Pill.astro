---
export interface Props {
  text: string
  size?: 'big' | 'small'
  href?: string
  class?: string
  // outline: a colored border and text instead of a fill (pass the border and text color in class)
  variant?: 'solid' | 'outline'
}

const { text, size = 'big', href, class: className, variant = 'solid' } = Astro.props
const variantClasses = variant === 'outline' ? 'border' : 'text-black shadow-sm'
---

{
  href ? (
    <a
      href={href}
      class:list={[
        `${className} ${variantClasses} inline-block rounded-control text-label uppercase`,
        { 'px-4 py-2': size === 'small' },
        { 'px-4 py-2 md:px-6 md:py-4': size === 'big' },
      ]}
    >
      {text}
    </a>
  ) : (
    <span
      class:list={[
        `${className} ${variantClasses} inline-block rounded-control text-label uppercase`,
        { 'px-4 py-2': size === 'small' },
        { 'px-4 py-2 md:px-6 md:py-4': size === 'big' },
      ]}
    >
      {text}
    </span>
  )
}
