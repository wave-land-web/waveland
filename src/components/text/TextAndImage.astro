---
import { Image } from 'astro:assets'
import LinkIcon from '../../assets/link.svg'
// Loaded as cached files, not inlined: together they were ~190 KB of homepage HTML
import waveOne from '../../assets/wave-1.svg?url'
import waveTwo from '../../assets/wave-2.svg?url'
import waveThree from '../../assets/wave-3.svg?url'

export interface Props {
  title: string
  text: string
  caseStudyUrl: string
  linkText: string
  image: ImageMetadata
  imageAlt: string
  color: string
  isReversed?: boolean
  class?: string
}

const {
  title,
  text,
  caseStudyUrl,
  linkText,
  image,
  imageAlt,
  color,
  class: className,
  isReversed,
} = Astro.props

const waves: Record<string, string> = { purple: waveOne, orange: waveTwo, green: waveThree }
---

<div
  class:list={[
    'grid gap-6 md:gap-8 lg:gap-16 items-center lg:grid-cols-2 lsa lsa-slide-up',
    className,
  ]}
>
  <div
    class:list={[
      'font-header',
      {
        'lg:order-2': isReversed,
      },
    ]}
  >
    <h2
      class:list={[
        {
          'text-purple': color === 'purple',
          'text-orange': color === 'orange',
          'text-green': color === 'green',
        },
      ]}
    >
      {title}
    </h2>
    <p class="h2">
      {text}
    </p>
  </div>
  <article
    class:list={[
      'text-container p-0 h-96 group',
      {
        'hover:border-purple max-md:border-purple': color === 'purple',
        'hover:border-orange max-md:border-orange': color === 'orange',
        'hover:border-green max-md:border-green': color === 'green',
      },
    ]}
  >
    <a href={caseStudyUrl} class="w-full h-full">
      <!-- Shown at 144px; sizes asks for 1.5x that so the small screenshot text stays crisp -->
      <Image
        src={image}
        alt={imageAlt}
        width={144}
        widths={[216, 432, 648]}
        sizes="216px"
        quality={90}
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 max-w-36 z-10"
      />
      <!-- The wave is a mask over the text color, so it still changes color on hover -->
      <span
        aria-hidden="true"
        class:list={[
          'wave absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-72 bg-current text-darkGrey transition-colors duration-(--transition)',
          {
            'group-hover:text-purple max-md:text-purple': color === 'purple',
            'group-hover:text-orange max-md:text-orange': color === 'orange',
            'group-hover:text-green max-md:text-green': color === 'green',
          },
        ]}
        style={`--wave: url(${waves[color]})`}
      ></span>
      <p
        class:list={[
          'flex items-center font-header text-label gap-2 absolute bottom-0 p-4',
          {
            'hover:text-purple group-hover:text-purple max-md:text-purple transition-colors duration-(--transition)':
              color === 'purple',
            'hover:text-orange group-hover:text-orange max-md:text-orange transition-colors duration-(--transition)':
              color === 'orange',
            'hover:text-green group-hover:text-green max-md:text-green transition-colors duration-(--transition)':
              color === 'green',
          },
        ]}
      >
        <LinkIcon class="size-5 md:size-6 stroke-2" />{linkText}
      </p>
    </a>
  </article>
</div>

<style>
  .wave {
    mask: var(--wave) center / contain no-repeat;
  }
</style>
