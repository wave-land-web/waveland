---
import { EMAIL, EMAIL_HREF } from '../../lib/site'
import { Icon } from 'astro-icon/components'
import CTA from './CTA'

export interface Props {
  title: string
  description?: string
  linkText: string
  linkSrc: string
}

const { title, description, linkText, linkSrc } = Astro.props
---

<!-- Heading on the left, the pitch on the right. The button always comes last, so it closes the section when the columns stack. -->
<div class="grid gap-6 md:gap-16 md:grid-cols-2 md:items-center lsa lsa-slide-up">
  <h2 class="h2">{title}</h2>
  <div class="flex flex-col items-start gap-6">
    {description && <p class="text-lightGrey max-w-[48ch]">{description}</p>}
    <a href={EMAIL_HREF} class="inline-flex gap-2 items-center text-grey hover:text-purple link-underline"
      ><Icon name="tabler:mail" />{EMAIL}</a
    >
    <CTA
      tag="link"
      href={linkSrc}
      {...(linkSrc.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
      text={linkText}
      size="large"
    />
  </div>
</div>
