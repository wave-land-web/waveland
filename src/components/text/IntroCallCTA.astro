---
import { EMAIL, EMAIL_HREF } from '../../lib/site'
import { Icon } from 'astro-icon/components'
import CTA from './CTA'

export interface Props {
  title: string
  description?: string
  linkText: string
  linkSrc: string
}

const { title, description, linkText, linkSrc } = Astro.props
---

<div class="grid gap-2 md:gap-16 md:grid-cols-2 lsa lsa-slide-up">
  <div>
    <h2 class="h2 md:mb-4">{title}</h2>

    <!-- Desktop Email -->
    <a
      href={EMAIL_HREF}
      aria-label="Email"
      title="Email"
      class="hidden md:inline-flex gap-2 items-center text-grey hover:text-purple link-underline"
      ><Icon name="tabler:mail" />{EMAIL}
    </a>
  </div>
  <div>
    <CTA
      tag="link"
      href={linkSrc}
      {...(linkSrc.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
      text={linkText}
      size="large"
      className="mb-4"
    />
    {description && <p class="text-lightGrey">{description}</p>}
  </div>

  <!-- Mobile Email -->
  <a
    href={EMAIL_HREF}
    class="inline-flex md:hidden gap-2 items-center mt-2 text-grey hover:text-purple link-underline"
    ><Icon name="tabler:mail" />{EMAIL}
  </a>
</div>
