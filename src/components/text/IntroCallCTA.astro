---
import { EMAIL, EMAIL_HREF } from '../../lib/site'
import { Icon } from 'astro-icon/components'
import Link from './Link.tsx'

export interface Props {
  title: string
  description?: string
  linkText: string
  linkSrc: string
}

const { title, description, linkText, linkSrc } = Astro.props
---

<div class="grid gap-2 md:gap-16 md:grid-cols-2 lsa lsa-slide-up">
  <div>
    <h2 class="h2 md:mb-4">{title}</h2>

    <!-- Desktop Email -->
    <a
      href={EMAIL_HREF}
      aria-label="Email"
      title="Email"
      class="hidden md:inline-flex gap-2 items-center text-grey hover:text-purple"
      ><Icon name="tabler:mail" />{EMAIL}
    </a>
  </div>
  <div>
    <Link
      text={linkText}
      url={linkSrc}
      newWindow={linkSrc.startsWith('http')}
      size="display"
      linkClass="mb-2 md:mb-4"
    />
    {description && <p class="text-lightGrey">{description}</p>}
  </div>

  <!-- Mobile Email -->
  <a
    href={EMAIL_HREF}
    aria-label="Email"
    title="Email"
    class="inline-flex md:hidden gap-2 items-center mt-2 text-grey hover:text-purple"
    ><Icon name="tabler:mail" />{EMAIL}
  </a>
</div>
