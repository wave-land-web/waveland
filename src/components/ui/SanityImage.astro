---
import type { SanityAsset } from '@sanity/image-url'
import { sanityImageSizes } from '../../sanity/lib/urlForImage'

export interface Props {
  image: SanityAsset
  alt: string
  sizes: string
  // The first image on the page: load it right away instead of lazily
  priority?: boolean
  // Srcset widths, for images shown small (defaults to the standard set)
  widths?: number[]
  class?: string
}

const { image, alt, sizes, priority = false, widths, class: className } = Astro.props

const { width, height, srcFor, srcset } = sanityImageSizes(image, widths)
---

<img
  class={className}
  src={srcFor(Math.min(width, 1200))}
  srcset={srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  decoding="async"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
/>
