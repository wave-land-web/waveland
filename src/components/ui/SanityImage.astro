---
import type { SanityAsset } from '@sanity/image-url/lib/types/types'
import { urlForImage } from '../../sanity/lib/urlForImage'

export interface Props {
  image: SanityAsset
  alt: string
  sizes: string
  // The first image on the page: load it right away instead of lazily
  priority?: boolean
  class?: string
}

const { image, alt, sizes, priority = false, class: className } = Astro.props

// Asset refs carry the original size: image-<id>-<width>x<height>-<format>
const [, width = 1600, height = 900] = image?.asset?._ref?.match(/-(\d+)x(\d+)-/)?.map(Number) ?? []
const widths = [480, 800, 1200, 1600, 2400]
const srcFor = (w: number) => urlForImage(image).width(w).quality(75).auto('format').url()
const srcset = widths
  .filter((w) => w <= width)
  .map((w) => `${srcFor(w)} ${w}w`)
  .join(', ')
---

<img
  class={className}
  src={srcFor(1200)}
  srcset={srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  decoding="async"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
/>
