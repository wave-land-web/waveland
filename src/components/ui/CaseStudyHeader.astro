---
import type { SanityAsset } from '@sanity/image-url'
import LinkIcon from '../../assets/link.svg'
import DateAndReadTime from '../text/DateAndReadTime.astro'
import Pill from '../text/Pill.astro'
import SanityImage from './SanityImage.astro'

export interface Props {
  title: string
  published: string
  minutesRead: number
  image: SanityAsset
  imageAlt: string
  services: string[]
  liveUrl?: string
}

const { title, published, minutesRead, image, imageAlt, services, liveUrl } = Astro.props

// Pill colors match the homepage pills
const serviceColors: Record<string, string> = {
  Development: 'border-purple text-purple',
  Strategy: 'border-orange text-orange',
  Partnership: 'border-green text-green',
}
---

<header class="pt-[calc(4rem+var(--nav-height))] text-left hero-in">
  <div class="container lg:max-w-6xl mx-auto flex flex-col gap-4 md:gap-6 justify-center">
    <DateAndReadTime
      class="justify-start md:justify-center"
      published={published}
      minutesRead={minutesRead}
    />
    <h1 class="text-left md:text-center">{title}</h1>
    <div class="flex flex-col items-start md:items-center gap-6 md:gap-8 mb-6 md:mb-8">
      <div class="flex flex-wrap gap-3">
        {
          services.map((service: string) => (
            <Pill
              text={`${service}`}
              size="small"
              variant="outline"
              class={`${serviceColors[service]} hero-in`}
            />
          ))
        }
      </div>
      {
        liveUrl && (
          <a
            href={liveUrl}
            class="flex items-center gap-2 font-header text-grey hover:text-purple link-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <LinkIcon class="size-5 md:size-6 stroke-2" />
            Visit Live Site
          </a>
        )
      }
    </div>
    <SanityImage
      image={image}
      alt={imageAlt}
      sizes="(min-width: 1152px) 1104px, calc(100vw - 2rem)"
      priority
      class="w-full h-auto mb-8 md:mb-16"
    />
  </div>
</header>
