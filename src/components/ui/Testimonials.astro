---
import type { Testimonial } from '../../lib/data/testimonials'

export interface Props {
  data: Testimonial[]
}

const { data } = Astro.props
---

<div class="swiper">
  <div class="swiper-wrapper mb-16">
    {
      data.map((testimonial) => {
        return (
          <blockquote class="swiper-slide">
            <p class="mb-4 text-lightGrey">
              <em>"{testimonial.quote}"</em>
            </p>
            <cite>
              {testimonial.href ? (
                <a
                  class="text-purple link-underline"
                  href={testimonial.href}
                  {...(testimonial.href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  - {testimonial.citation}
                </a>
              ) : (
                <span class="text-purple">- {testimonial.citation}</span>
              )}
            </cite>
          </blockquote>
        )
      })
    }
  </div>
  <div class="swiper-pagination"></div>
</div>

<style is:inline>
  :root {
    --swiper-theme-color: var(--color-purple);
    --swiper-pagination-bullet-inactive-color: var(--color-grey);
    --swiper-pagination-bullet-size: 0.75rem;
    --swiper-pagination-bullet-horizontal-gap: 0.5rem;
  }
</style>

<script>
  import Swiper from 'swiper'
  import 'swiper/css'
  import 'swiper/css/pagination'
  import { Pagination } from 'swiper/modules'

  new Swiper('.swiper', {
    modules: [Pagination],
    grabCursor: true,
    loop: true,
    autoHeight: true,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
  })
</script>
