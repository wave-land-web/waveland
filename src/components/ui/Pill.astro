---
// An outlined label (not a link): pass the border and text color in class
export interface Props {
  text: string
  size?: 'big' | 'small'
  class?: string
  style?: string
}

const { text, size = 'big', class: className, style } = Astro.props
---

<span
  class:list={[
    className,
    'inline-block border rounded-control label',
    'px-4 py-2',
    size === 'big' && 'md:px-6 md:py-4',
  ]}
  style={style}
>
  {text}
</span>
