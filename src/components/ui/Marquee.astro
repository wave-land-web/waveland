---
// Logos load as image files, cached once across pages. Inlined, they added ~300 KB to every page.
const files = import.meta.glob<string>('../../assets/logos/*.svg', { eager: true, query: '?url', import: 'default' })

const logos = [
  { slug: 'moonbelly-makes', name: 'Moonbelly Makes' },
  { slug: 'the-story-shack', name: 'The Story Shack' },
  { slug: 'aaa', name: 'AAA' },
  { slug: 'supervoid', name: 'Supervoid' },
  { slug: 'church-dwight', name: 'Church & Dwight' },
  { slug: 'dephy', name: 'Dephy' },
  { slug: 'born-yesterday-bakery', name: 'Born Yesterday Bakery' },
  { slug: 'la-roche-posay', name: 'La Roche-Posay' },
  { slug: 'robby-webb', name: 'Robby Webb' },
  { slug: 'loreal', name: "L'Oréal" },
  { slug: 'pmi', name: 'PMI' },
].map((logo) => ({ ...logo, src: files[`../../assets/logos/${logo.slug}.svg`] }))
---

<div class="marquee-wrapper container md:max-w-screen-3xl">
  <h2 class="mb-10 text-center font-body text-label uppercase tracking-wide text-grey">Brands I’ve built for, agency and in-house</h2>
  <div class="marquee">
    <div class="marquee-content">
      {logos.map((logo) => <img src={logo.src} alt={logo.name} width="100" height="100" loading="lazy" decoding="async" />)}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {logos.map((logo) => <img src={logo.src} alt="" width="100" height="100" loading="lazy" decoding="async" />)}
    </div>
  </div>
</div>

<style>
  .marquee-wrapper {
    --gap: clamp(4rem, 10vw, 6rem);
    --duration: 30s;
    padding: 4rem 0;
    margin: 0 auto;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      var(--color-black) 20%,
      var(--color-black) 80%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      var(--color-black) 20%,
      var(--color-black) 80%,
      transparent
    );
  }

  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: var(--gap);
  }

  .marquee-content {
    flex-shrink: 0;
    display: flex;
    justify-content: space-around;
    gap: var(--gap);
    min-width: 100%;
    animation: scroll var(--duration) linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation-play-state: paused;
    }
  }

  .marquee-content img {
    display: grid;
    place-items: center;
    width: clamp(75px, 10vw, 100px);
    height: clamp(75px, 10vw, 100px);
    flex-shrink: 0;
    object-fit: contain;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }
</style>
