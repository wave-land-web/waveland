---
import { Image } from 'astro:assets'
import ArrowIcon from './ArrowIcon'
// Loaded as cached files, not inlined: together they were ~190 KB of homepage HTML
import waveOne from '../../assets/wave-1.svg?url'
import waveTwo from '../../assets/wave-2.svg?url'
import waveThree from '../../assets/wave-3.svg?url'

export interface Props {
  title: string
  text: string
  caseStudyUrl: string
  linkText: string
  image: ImageMetadata
  imageAlt: string
  color: 'purple' | 'orange' | 'green'
  isReversed?: boolean
  class?: string
}

const { title, text, caseStudyUrl, linkText, image, imageAlt, color, class: className, isReversed } = Astro.props

const waves: Record<string, string> = { purple: waveOne, orange: waveTwo, green: waveThree }
---

<!-- --accent is the row's color: the title, and the card's border, wave and link on hover (always on, below md) -->
<div class:list={['section-split items-center lsa', className]} style={`--accent: var(--color-${color})`}>
  <div class:list={['font-header', { 'lg:order-2': isReversed }]}>
    <h2 class="text-(--accent)">{title}</h2>
    <p class="h2">{text}</p>
  </div>
  <article class="text-container p-0 h-96 group hocus-within:border-(--accent) max-md:border-(--accent)">
    <a href={caseStudyUrl} class="block w-full h-full rounded-media">
      <!-- Shown at 144px; sizes asks for 1.5x that so the small screenshot text stays crisp -->
      <Image
        src={image}
        alt={imageAlt}
        width={144}
        widths={[216, 432, 648]}
        sizes="216px"
        quality={90}
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 max-w-36 z-10"
      />
      <!-- The wave is a mask over the text color, so it still changes color on hover -->
      <span
        aria-hidden="true"
        class="wave absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-72 bg-current text-darkGrey transition-colors duration-(--transition) group-hocus:text-(--accent) max-md:text-(--accent)"
        style={`--wave: url(${waves[color]})`}
      ></span>
      <p class="link-arrow font-header text-label absolute bottom-0 p-4 transition-colors duration-(--transition) group-hocus:text-(--accent) max-md:text-(--accent)">
        {linkText}
        <ArrowIcon />
      </p>
    </a>
  </article>
</div>

<style>
  .wave {
    mask: var(--wave) center / contain no-repeat;
  }
</style>
