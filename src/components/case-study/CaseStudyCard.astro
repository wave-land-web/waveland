---
import type { CASE_STUDIES_QUERY_RESULT } from '../../sanity/sanity.types'
import Pill from '../ui/Pill.astro'
import SanityImage from '../ui/SanityImage.astro'
import { platformTags } from '../../lib/text'

export interface Props {
  caseStudy: CASE_STUDIES_QUERY_RESULT['caseStudies'][number]
  // The first card on the page is its largest image
  priority?: boolean
  // Full width from lg, with the cover beside the text
  featured?: boolean
}

const { caseStudy, priority = false, featured = false } = Astro.props

// Who the work was for: agency work (for or alongside one) or a client of my own
const workedWithLabels: Record<string, string> = {
  'for-agency': 'Agency',
  'with-agency': 'Agency',
  direct: 'Client',
}
const tags = [caseStudy.platform, workedWithLabels[caseStudy.workedWith]].filter(Boolean)
---

<article class:list={['lsa', featured && 'lg:col-span-2']} data-platforms={platformTags(caseStudy.platform).join(' ')}>
  <!-- The whole card is the link; the title turns purple and the image zooms when it's hovered or focused -->
  <a
    href={`/case-studies/${caseStudy.slug.current}/`}
    class:list={[
      'group rounded-media w-full h-full hover:text-white flex flex-col gap-8',
      featured && 'lg:grid lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-12',
    ]}
  >
    <!-- The image scales inside this frame, so it never grows past the card or its focus outline -->
    <div class="overflow-hidden rounded-media">
      <SanityImage
        image={caseStudy.mainImage}
        alt={caseStudy.mainImage.alt}
        sizes={
          featured
            ? '(min-width: 1024px) calc((min(100vw, 1600px) - 7rem) * 7 / 12), (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)'
            : '(min-width: 1024px) calc((min(100vw, 1600px) - 7rem) / 2), (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)'
        }
        priority={priority}
        class="w-full h-auto aspect-video brightness-90 group-hover:brightness-100 group-hocus:scale-102 transition-all duration-(--transition) ease-in-out"
      />
    </div>

    <div class="stack">
      <div class="flex flex-col gap-3">
        <h2 class={featured ? 'h2' : 'h3'}>
          <span class="group-hocus:text-purple transition-colors duration-(--transition) ease-in-out">{caseStudy.title}</span>
        </h2>
        {tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <Pill text={tag} size="small" class="border-darkGrey text-lightGrey" />
              </li>
            ))}
          </ul>
        )}
      </div>
      <p class="text-prose text-grey">{caseStudy.description}</p>
    </div>
  </a>
</article>
