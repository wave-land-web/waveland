---
import type { SanityDocument } from '@sanity/client'
import SanityImage from '../ui/SanityImage.astro'

export interface Props {
  caseStudy: SanityDocument
  // The first card on the page is its largest image
  priority?: boolean
  // Full width from lg, with the cover beside the text
  featured?: boolean
}

const { caseStudy, priority = false, featured = false } = Astro.props

const workedWithLabels: Record<string, string> = {
  'for-agency': 'for an agency',
  'with-agency': 'with an agency',
  direct: 'direct client',
}
const meta = [caseStudy.platform, workedWithLabels[caseStudy.workedWith]].filter(Boolean).join(', ')
// The platform family the filters use: "Astro + Sanity" files under Astro
const platformFamily = caseStudy.platform?.split(' + ')[0] ?? ''
---

<!-- The view-transition-name lets cards glide into place when the filter changes; the class sets its timing (global.css) -->
<article
  class:list={['lsa', featured && 'lg:col-span-2']}
  data-platform={platformFamily}
  style={`view-transition-name: case-${caseStudy.slug.current}; view-transition-class: move`}
>
  <!-- The whole card is the link; the title underlines when it's hovered or focused -->
  <a
    href={`/case-studies/${caseStudy.slug.current}/`}
    class:list={[
      'group rounded-media w-full h-full hover:text-white flex flex-col gap-4',
      featured && 'lg:grid lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-12',
    ]}
  >
    <!-- The image scales inside this frame, so it never grows past the card or its focus outline -->
    <div class:list={['overflow-hidden rounded-media', featured ? 'mb-4 lg:mb-0' : 'mb-4']}>
      <SanityImage
        image={caseStudy.mainImage}
        alt={caseStudy.mainImage.alt}
        sizes={
          featured
            ? '(min-width: 1024px) calc((min(100vw, 1600px) - 7rem) * 7 / 12), (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)'
            : '(min-width: 1024px) calc((min(100vw, 1600px) - 7rem) / 2), (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)'
        }
        priority={priority}
        class="w-full h-auto aspect-video brightness-90 group-hover:brightness-100 group-hover:scale-102 group-focus-visible:scale-102 transition-all duration-(--transition) ease-in-out"
      />
    </div>

    <div class="stack">
      <div class="flex flex-col gap-2">
        <h2 class={featured ? 'h2' : 'h3'}>
          <span class="underline decoration-1 underline-offset-[0.2em] decoration-transparent group-hover:text-purple group-hover:decoration-current group-focus-visible:text-purple group-focus-visible:decoration-current transition-colors duration-(--transition) ease-in-out">
            {caseStudy.title}
          </span>
        </h2>
        {meta && <p class="text-prose text-lightGrey">{meta}</p>}
      </div>
      <p class="text-prose text-grey">{caseStudy.description}</p>
    </div>
  </a>
</article>
