---
import type { SanityAsset } from '@sanity/image-url'
import LinkIcon from '../../assets/link.svg'
import DateAndReadTime from '../ui/DateAndReadTime.astro'
import Pill from '../ui/Pill.astro'
import SanityImage from '../ui/SanityImage.astro'
import { HERO_SIZES } from './hero'

export interface Props {
  title: string
  // Names the cover and title for the morph from a case study card (view transitions)
  slug: string
  published: string
  minutesRead: number
  image: SanityAsset
  imageAlt: string
  services: string[]
  liveUrl?: string
}

const { title, slug, published, minutesRead, image, imageAlt, services, liveUrl } = Astro.props

// Pill colors match the homepage pills
const serviceColors: Record<string, string> = {
  Development: 'border-purple text-purple',
  Strategy: 'border-orange text-orange',
  Partnership: 'border-green text-green',
}

// Entrance order, like the homepage hero: date, title, each pill, the live link. The image starts early
// (it's the largest thing on the page, and holding it back would delay when the page looks loaded).
const pillStart = 2
const linkIndex = pillStart + services.length
---

<header class="pt-page-top text-left">
  <div class="stack justify-center">
    <DateAndReadTime
      class="justify-start md:justify-center hero-in"
      published={published}
      minutesRead={minutesRead}
    />
    <!-- data-morph: skips its entrance when it arrives by morphing from a card (see Layout.astro) -->
    <h1 class="text-left md:text-center hero-in" style="--i: 1" data-morph>
      <span class="inline-block" style={`view-transition-name: title-${slug}; view-transition-class: move`}>{title}</span>
    </h1>
    <div class="flex flex-col items-start md:items-center gap-6 md:gap-8 mb-6 md:mb-8">
      <div class="flex flex-wrap gap-3">
        {
          services.map((service: string, i: number) => (
            <Pill
              text={`${service}`}
              size="small"
              class={`${serviceColors[service]} hero-in`}
              style={`--i: ${pillStart + i}`}
            />
          ))
        }
      </div>
      {
        liveUrl && (
          <a
            href={liveUrl}
            class="flex items-center gap-2 font-header text-grey hover:text-purple link-underline hero-in"
            style={`--i: ${linkIndex}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <LinkIcon class="size-5 md:size-6 stroke-2" />
            Visit Live Site
          </a>
        )
      }
    </div>
    <!-- The frame clips the image so it can drift for a subtle parallax -->
    <div
      class="hero-frame mb-header hero-in"
      style={`--i: 2; view-transition-name: cover-${slug}; view-transition-class: move cover`}
      data-morph
    >
      <SanityImage
        image={image}
        alt={imageAlt}
        sizes={HERO_SIZES}
        priority
        class="hero-image"
      />
    </div>
  </div>
</header>

<style>
  /* The frame is a little shorter than the 16:9 cover, so the image overhangs it top and bottom (never at the sides,
     where the covers put their phone mockups). The height cap leaves some of the case study showing on large screens. */
  .hero-frame {
    position: relative;
    /* clip, not hidden: a hidden frame becomes the scroll container view() tracks, and the parallax never moves */
    overflow: clip;
    border-radius: var(--radius-media);
    aspect-ratio: 16 / 8.4;
    max-height: 80svh;
  }

  /* Centered vertically in the frame; the parallax moves it 3% either side of center */
  .hero-frame :global(.hero-image) {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: auto;
    translate: 0 -50%;
    border-radius: 0;
  }

  /* Parallax: the image drifts a little slower than the page. Scroll-driven, so no JavaScript;
     browsers without it, and reduced motion, get the still image. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero-frame :global(.hero-image) {
        animation: hero-parallax linear both;
        animation-range: cover;
      }
      /* Its own rule: the CSS minifier folds animation-timeline into the shorthand, which browsers reject */
      .hero-frame :global(img.hero-image) {
        animation-timeline: view();
      }
    }
  }

  /* The image overhangs the frame by about 3.3% of its height on each side, so 3% of drift never shows an edge */
  @keyframes hero-parallax {
    from {
      translate: 0 -53%;
    }
    to {
      translate: 0 -47%;
    }
  }
</style>
