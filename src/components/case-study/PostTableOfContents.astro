---
import type { BlockContent } from '../../sanity/sanity.types'
import { blockText, headingId } from '../../lib/text'

interface Props {
  post: { body: BlockContent }
}

const { post } = Astro.props

// Retrieve + format heading data for anchor links and table of contents
const headings = post.body
  .filter((block) => block._type === 'block' && block.style === 'h2')
  .map((heading) => {
    const text = blockText(heading)
    return { id: headingId(text), text }
  })
---

<div class="h-full">
  <nav
    id="case-study-table-of-contents"
    aria-label="Case Study Table of Contents"
    class="text-container p-4 md:p-6 gap-4 md:gap-6 md:sticky md:top-sticky md:self-start"
  >
    <h2 class="text-purple text-body">Table of Contents</h2>
    <ol class="list-none p-0 flex flex-col gap-2">
      {headings.map((heading: { id: string; text: string }) => (
        <li class="font-header">
          <!-- The line grows inside a fixed slot, so the heading never moves or rewraps on hover.
                 aria-current marks the section being read (set by the script below). -->
          <a href={`#${heading.id}`} data-section-id={heading.id} class="group grid grid-cols-[2.5rem_1fr] gap-x-3">
            <span aria-hidden="true" class="label h-lh flex items-center">
              <span class="h-0.5 w-full rounded-control bg-grey origin-left scale-x-50 transition-[scale,background-color] duration-(--transition) ease-in-out group-hocus:scale-x-100 group-hocus:bg-green group-aria-[current=location]:scale-x-100 group-aria-[current=location]:bg-green" />
            </span>
            <span class="text-label text-grey transition-colors duration-(--transition) ease-in-out group-hocus:text-green group-aria-[current=location]:text-green">
              {heading.text}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</div>

<script>
  import { alignWith } from '../../lib/align'

  const toc = document.querySelector<HTMLElement>('#case-study-table-of-contents')
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#case-study-table-of-contents a[data-section-id]')]
  const headings = links
    .map((link) => document.getElementById(link.dataset.sectionId ?? ''))
    .filter((heading): heading is HTMLElement => heading !== null)

  // The table of contents only sticks beside the article from md up; on phones it sits above it
  const md = matchMedia('(min-width: 768px)')
  const isSticky = () => toc !== null && md.matches

  // Highlight the section being read: the last heading scrolled above the table of contents
  // (or above 30% of the screen, when it isn't sticky)
  const list = toc?.querySelector('ol')
  let frame = 0
  let currentId: string | undefined
  function update() {
    frame = 0
    const tocBottom = isSticky() ? (list?.getBoundingClientRect().bottom ?? 0) : 0
    const line = Math.max(window.innerHeight * 0.3, tocBottom)
    const id = headings.filter((heading) => heading.getBoundingClientRect().top <= line).at(-1)?.id
    if (id === currentId) return
    currentId = id
    links.forEach((link) => {
      if (link.dataset.sectionId === id) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    })
  }

  // A heading scrolls level with its table of contents link, so the two read as one line. This runs for the table of
  // contents links, the headings' own links, and a page opened at #section. On phones the normal jump (with scroll-margin) is kept.
  function align(heading: HTMLElement, behavior: ScrollBehavior) {
    const link = links.find((l) => l.dataset.sectionId === heading.id)
    if (!link || !toc) return
    alignWith(heading, link.lastElementChild ?? link, toc, behavior)
  }

  // Hashes come back percent-encoded (curly apostrophes, accents), ids don't
  const sectionId = (hash: string) => decodeURIComponent(hash.slice(1))
  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].filter((a) =>
    headings.some((heading) => sectionId(a.hash) === heading.id),
  )
  sectionLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const heading = document.getElementById(sectionId(link.hash))
      if (!heading || !isSticky()) return
      event.preventDefault()
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
      align(heading, reduce ? 'instant' : 'smooth')
      history.pushState(null, '', `#${heading.id}`)
      heading.focus({ preventScroll: true })
    })
  })

  // Opened at #section (a fresh visit, not a reload or back, where the browser restores the scroll): line it up once the
  // images above it have their size, unless the reader has scrolled in the meantime
  const target = headings.find((heading) => sectionId(location.hash) === heading.id)
  const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined
  if (target && navigation?.type === 'navigate') {
    let scrolled = false
    const markScrolled = () => (scrolled = true)
    for (const type of ['wheel', 'touchmove', 'keydown', 'pointerdown']) addEventListener(type, markScrolled, { once: true, passive: true })
    const lineUp = () => requestAnimationFrame(() => !scrolled && isSticky() && align(target, 'instant'))
    if (document.readyState === 'complete') lineUp()
    else window.addEventListener('load', lineUp, { once: true })
  }

  if (headings.length > 0) {
    window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true })
    update()
  }
</script>
