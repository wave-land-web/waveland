---
import type { SanityDocument } from '@sanity/client'
import { blockText, headingId } from '../../lib/text'

interface Props {
  post: SanityDocument
}

const { post } = Astro.props

// Retrieve + format heading data for anchor links and table of contents
const headings: { id: string; text: string }[] = post.body
  .filter((block: SanityDocument) => block.style === 'h2')
  .map((heading: SanityDocument) => {
    const text = blockText(heading)
    return { id: headingId(text), text }
  })
---

<div class="h-full">
  <nav
    id="case-study-table-of-contents"
    aria-label="Case Study Table of Contents"
    class="text-container p-4 md:p-6 gap-4 md:gap-6 md:sticky md:top-sticky md:self-start"
  >
    <h2 class="text-purple text-body">Table of Contents</h2>
    <ol class="list-none p-0 flex flex-col gap-2">
      {
        headings.map((heading: { id: string; text: string }) => (
          <li class="font-header">
            <!-- The line grows inside a fixed slot, so the heading never moves or rewraps on hover.
                 data-active marks the section being read (set by the script below). -->
            <a href={`#${heading.id}`} data-section-id={heading.id} class="group grid grid-cols-[2.5rem_1fr] gap-x-3">
              <span aria-hidden="true" class="label h-[1lh] flex items-center">
                <span class="h-0.5 w-full rounded-control bg-grey origin-left scale-x-50 transition-[scale,background-color] duration-(--transition) ease-in-out group-hover:scale-x-100 group-hover:bg-green group-focus-visible:scale-x-100 group-focus-visible:bg-green group-data-active:scale-x-100 group-data-active:bg-green" />
              </span>
              <span class="text-label text-grey transition-colors duration-(--transition) ease-in-out group-hover:text-green group-focus-visible:text-green group-data-active:text-green">
                {heading.text}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<script>
  const toc = document.querySelector<HTMLElement>('#case-study-table-of-contents')
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#case-study-table-of-contents a[data-section-id]')]
  const headings = links
    .map((link) => document.getElementById(link.dataset.sectionId ?? ''))
    .filter((heading): heading is HTMLElement => heading !== null)

  // The table of contents only sticks beside the article from md up; on phones it sits above it
  const isSticky = () => toc !== null && getComputedStyle(toc).position === 'sticky'

  // Where a line of text sits: the middle of its first line
  const firstLineMiddle = (el: Element) => el.getBoundingClientRect().top + parseFloat(getComputedStyle(el).lineHeight) / 2

  // Highlight the section being read: the last heading scrolled above the table of contents
  // (or above 30% of the screen, when it isn't sticky)
  let frame = 0
  function update() {
    frame = 0
    const tocBottom = isSticky() ? (toc?.querySelector('ol')?.getBoundingClientRect().bottom ?? 0) : 0
    const line = Math.max(window.innerHeight * 0.3, tocBottom)
    const current = headings.filter((heading) => heading.getBoundingClientRect().top <= line).at(-1)
    links.forEach((link) => {
      const active = link.dataset.sectionId === current?.id
      link.toggleAttribute('data-active', active)
      if (active) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    })
  }

  // Clicking a link scrolls its heading level with the link, so the two read as one line.
  // On phones the normal jump to the heading (with scroll-margin) is kept.
  links.forEach((link) => {
    link.addEventListener('click', (event) => {
      const heading = document.getElementById(link.dataset.sectionId ?? '')
      if (!heading || !isSticky()) return
      event.preventDefault()
      // Where the link will sit once the table of contents is stuck (it may not be yet, near the top of the page)
      const label = link.lastElementChild ?? link
      const stuckTop = parseFloat(getComputedStyle(toc!).top)
      const labelWhenStuck = stuckTop + (firstLineMiddle(label) - toc!.getBoundingClientRect().top)
      const top = window.scrollY + firstLineMiddle(heading) - labelWhenStuck
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' })
      history.pushState(null, '', `#${heading.id}`)
      heading.focus({ preventScroll: true })
    })
  })

  if (headings.length > 0) {
    window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true })
    update()
  }
</script>
