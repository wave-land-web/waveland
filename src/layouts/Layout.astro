---
import Footer from '../components/layout/Footer.astro'
import Navigation from '../components/layout/navigation/Navigation.astro'
import '../styles/global.css'
import { Font } from 'astro:assets'
import { EMAIL } from '../lib/site'

export interface Props {
  title: string
  description?: string
  socialImage?: string
  // 'article' for case studies, so link previews treat them as posts
  ogType?: 'website' | 'article'
  // Keep utility pages (404, success, unsubscribed) out of search results
  noindex?: boolean
  // Extra JSON-LD for this page, added after the business
  schema?: Record<string, unknown>[]
}

const {
  title,
  description = 'A development partner for brand agencies. Josh Nussbaum builds on WordPress, Webflow, Shopify and more, with SanityPress for custom builds. Madison, WI.',
  socialImage,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(socialImage || '/images/og-image.jpg', canonicalURL)

// Tells search engines who the business is and where it's based
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://wavelandweb.com/#business',
  name: 'Wave Land',
  url: 'https://wavelandweb.com/',
  logo: 'https://wavelandweb.com/apple-touch-icon.png',
  image: 'https://wavelandweb.com/images/og-image.jpg',
  description: 'A development partner for brand agencies. WordPress, Webflow, Shopify and more, with SanityPress for custom builds.',
  email: EMAIL,
  founder: { '@type': 'Person', name: 'Josh Nussbaum' },
  address: { '@type': 'PostalAddress', addressLocality: 'Madison', addressRegion: 'WI', addressCountry: 'US' },
  areaServed: 'US',
  sameAs: ['https://www.instagram.com/wavelandweb/', 'https://www.linkedin.com/company/wave-land/'],
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Scroll animations only hide content once JavaScript is running -->
    <script is:inline>document.documentElement.classList.add('lsa-on')</script>
    <!-- View transitions between pages (see global.css for the timing):
         - pageswap (old page): opening a case study names the clicked card's cover and title, to morph into its header
         - pagereveal (new page): mark the arrival, name the matching card when returning to the list, and show the
           scroll reveals already on screen, so nothing is hidden or animated twice -->
    <script is:inline>
      ;(() => {
        const slugOf = (url) => url && new URL(url).pathname.match(/^\/case-studies\/([^/]+)\/$/)?.[1]
        const isList = (url) => url && new URL(url).pathname === '/case-studies/'
        const nameCard = (slug, on) => {
          const card = slug && document.querySelector(`[data-vt-slug="${slug}"]`)
          if (!card) return
          for (const part of ['cover', 'title']) {
            const el = card.querySelector(`[data-vt="${part}"]`)
            if (!el) continue
            el.style.viewTransitionName = on ? `${part}-${slug}` : ''
            el.style.viewTransitionClass = on ? `move ${part}` : ''
          }
        }

        window.addEventListener('pageswap', (event) => {
          if (event.viewTransition) nameCard(slugOf(event.activation?.entry?.url), true)
        })

        window.addEventListener('pagereveal', (event) => {
          const root = document.documentElement
          // Names set for a transition that has finished (or a page restored from the back-forward cache)
          document.querySelectorAll('[data-vt]').forEach((el) => {
            el.style.viewTransitionName = ''
            el.style.viewTransitionClass = ''
          })
          if (!event.viewTransition) return

          const from = window.navigation?.activation?.from?.url
          root.classList.add('vt-arrival')
          if (isList(from)) root.classList.add('vt-from-list')
          if (isList(location.href)) nameCard(slugOf(from), true)

          document.querySelectorAll('.lsa').forEach((el) => {
            if (el.getBoundingClientRect().top < innerHeight) el.classList.add('active')
          })
          event.viewTransition.finished.finally(() => {
            root.classList.remove('vt-arrival', 'vt-from-list')
            nameCard(slugOf(from), false)
          })
        })
      })()
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      [business, ...schema].map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }

    <!-- Facebook -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <!-- Every share image is 1200×630, the size link previews expect -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="wavelandweb.com" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Preload Fonts -->
    <!-- Italics load when a page uses them; only the upright weights are preloaded -->
    <Font cssVariable="--font-monaspace" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-poppins" preload />

    <!-- Favicon & Theme -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- #101828 is --color-darkBlue (gray-900); meta tags can't read CSS variables -->
    <meta name="msapplication-TileColor" content="#101828" />
    <meta name="theme-color" content="#101828" />
  </head>

  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-1/2 focus:-translate-x-1/2 focus:z-50 focus:px-4 focus:py-3 focus:rounded-field focus:bg-purple focus:text-black"
      >Skip to Content</a
    >
    <Navigation />
    <!-- Skip link target, just below the fixed nav -->
    <div id="content" tabindex="-1" class="outline-none"></div>
    <slot />
    <Footer />

    <script is:inline data-astro-rerun>
      /**
       * Reveal `lsa` elements once, as they scroll into view (see the animation notes in global.css)
       */
      function handleAnimations() {
        const elements = document.querySelectorAll('.lsa')
        if (elements.length === 0) return

        // Arriving by view transition: anything parsed after the transition started, and already on screen, shows at once
        if (document.documentElement.classList.contains('vt-arrival')) {
          elements.forEach((el) => {
            if (el.getBoundingClientRect().top < innerHeight) el.classList.add('active')
          })
        }

        // Without IntersectionObserver, show everything rather than leave it hidden
        if (!('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('active'))
          return
        }

        // Trigger as soon as an element's top passes 90% of the viewport, however tall it is
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('active')
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -10% 0px' },
        )

        elements.forEach((el) => observer.observe(el))
      }

      document.addEventListener('DOMContentLoaded', handleAnimations)
    </script>
  </body>
</html>
