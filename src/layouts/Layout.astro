---
import Footer from '../components/ui/Footer.astro'
import Navigation from '../components/ui/navigation/Navigation.astro'
import '../styles/global.css'
import { Font } from 'astro:assets'
import { EMAIL } from '../lib/site'

export interface Props {
  title: string
  description?: string
  socialImage?: string
  // Extra JSON-LD for this page, added after the business
  schema?: Record<string, unknown>[]
}

const {
  title,
  description = 'Josh Nussbaum is a web developer in Madison, WI, and a development partner for brand agencies. Astro and Sanity, Webflow, Shopify, and more.',
  socialImage,
  schema = [],
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(socialImage || '/images/og-image.jpg', canonicalURL)

// Tells search engines who the business is and where it's based
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://wavelandweb.com/#business',
  name: 'Wave Land',
  url: 'https://wavelandweb.com/',
  logo: 'https://wavelandweb.com/apple-touch-icon.png',
  image: 'https://wavelandweb.com/images/og-image.jpg',
  description: 'A development partner for brand agencies. Astro and Sanity, Webflow, Shopify, and more.',
  email: EMAIL,
  founder: { '@type': 'Person', name: 'Josh Nussbaum' },
  address: { '@type': 'PostalAddress', addressLocality: 'Madison', addressRegion: 'WI', addressCountry: 'US' },
  areaServed: 'US',
  sameAs: ['https://www.instagram.com/wavelandweb/', 'https://www.linkedin.com/company/wave-land/'],
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Scroll animations only hide content once JavaScript is running -->
    <script is:inline>document.documentElement.classList.add('lsa-on')</script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      [business, ...schema].map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }

    <!-- Facebook -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <!-- Every share image is 1200×630, the size link previews expect -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="wavelandweb.com" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Preload Fonts -->
    <Font cssVariable="--font-monaspace" preload />
    <Font cssVariable="--font-poppins" preload />

    <!-- Favicon & Theme -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#101828" />
    <meta name="theme-color" content="#101828" />
  </head>

  <body>
    <Navigation />
    <slot />
    <Footer />
  </body>
</html>

<script is:inline data-astro-rerun>
  /**
   * Animate sections with the class `lsa` when they come into view
   */
  function handleAnimations() {
    if (!window.IntersectionObserver) {
      return console.log('IntersectionObserver not supported')
    }

    // Grab all sections to be animated
    const sections = document.querySelectorAll('.lsa')

    // Configure observer options
    if (sections.length !== 0) {
      const options = {
        root: null,
        rootMargin: '0px',
        threshold: 0.25,
      }

      // Initialize observer
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const section = entry.target

          // By default, animations repeat on scroll unless the section has the class `no-repeat`
          if (entry.isIntersecting) {
            section.classList.add('active')
          } else if (!entry.isIntersecting && !section.classList.contains('no-repeat')) {
            section.classList.remove('active')
          }
        })
      }, options)

      // Observe each section with the class `lsa`
      sections.forEach((section) => observer.observe(section))
    }
  }

  // Handle animations on page load
  document.addEventListener('DOMContentLoaded', handleAnimations)
</script>
